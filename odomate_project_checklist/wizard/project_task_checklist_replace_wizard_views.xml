<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="project_task_checklist_replace_wizard_view_form" model="ir.ui.view">
        <field name="name">project.task.checklist.replace.wizard.form</field>
        <field name="model">project.task.checklist.replace.wizard</field>
        <field name="arch" type="xml">
            <form string="Replace Checklist">
                <div class="alert alert-warning" role="alert">
                    <field name="warning_message" nolabel="1"/>
                </div>
                <group>
                    <field name="task_id" force_save="1"/>
                    <field name="current_template_id"/>
                    <field name="new_template_id" options="{'no_create': True}"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Replace Checklist" class="btn-primary" data-hotkey="q"/>
                    <button string="Discard" special="cancel" class="btn-secondary" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
