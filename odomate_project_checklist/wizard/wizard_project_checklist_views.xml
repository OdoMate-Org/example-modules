<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_checklist_replace_wizard_form" model="ir.ui.view">
        <field name="name">project.task.checklist.replace.wizard.form</field>
        <field name="model">project.task.checklist.replace.wizard</field>
        <field name="arch" type="xml">
            <form string="Replace Checklist">
                <field name="task_id" invisible="1"/>
                <div class="alert alert-warning" role="alert">
                    <field name="warning_message" nolabel="1"/>
                </div>
                <group>
                    <field name="new_template_id"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object"
                            string="Replace" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
