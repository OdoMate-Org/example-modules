<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="project_task_view_form_inherit_checklist" model="ir.ui.view">
        <field name="name">project.task.form.inherit.checklist</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='tag_ids']" position="after">
                <field name="checklist_has_progress" invisible="1"/>
                <field name="checklist_template_id" readonly="checklist_has_progress" options="{'no_create': True}"/>
                <button name="action_open_checklist_replace_wizard" type="object" string="Replace Checklist" icon="fa-exchange" class="btn-link" colspan="2" invisible="not checklist_has_progress"/>
            </xpath>
            <xpath expr="//field[@name='date_deadline']" position="after">
                <field name="checklist_date_start" string="Start Date"/>
                <field name="checklist_date_end" string="End Date"/>
            </xpath>
            <xpath expr="//notebook/page[1]" position="after">
                <page string="Checklist" name="checklist" invisible="not checklist_line_ids">
                    <group>
                        <field name="checklist_progress" widget="progressbar"/>
                    </group>
                    <field name="checklist_line_ids">
                        <list editable="bottom" decoration-success="state == 'done'" decoration-danger="state == 'cancelled'" decoration-warning="state == 'in_progress'">
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="note"/>
                            <field name="state" decoration-bf="1" decoration-success="state == 'done'" decoration-danger="state == 'cancelled'" decoration-warning="state == 'in_progress'" decoration-muted="state == 'to_do'"/>
                            <button name="action_start" type="object" string="Start" icon="fa-play" invisible="state != 'to_do'"/>
                            <button name="action_done" type="object" string="Done" icon="fa-check" invisible="state not in ('to_do', 'in_progress')"/>
                            <button name="action_cancel" type="object" string="Cancel" icon="fa-times" invisible="state not in ('to_do', 'in_progress')"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="project_task_view_list_inherit_checklist" model="ir.ui.view">
        <field name="name">project.task.list.inherit.checklist</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_tree2"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="checklist_progress" widget="progressbar" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="project_task_view_search_inherit_checklist" model="ir.ui.view">
        <field name="name">project.task.search.inherit.checklist</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_search_form"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="checklist_template_id"/>
                <filter string="With Checklist" name="with_checklist" domain="[('checklist_line_ids', '!=', False)]"/>
            </xpath>
        </field>
    </record>

</odoo>
