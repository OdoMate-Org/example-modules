<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="project_checklist_template_view_list" model="ir.ui.view">
        <field name="name">project.checklist.template.list</field>
        <field name="model">project.checklist.template</field>
        <field name="arch" type="xml">
            <list string="Checklists">
                <field name="name"/>
                <field name="line_count"/>
            </list>
        </field>
    </record>

    <record id="project_checklist_template_view_form" model="ir.ui.view">
        <field name="name">project.checklist.template.form</field>
        <field name="model">project.checklist.template</field>
        <field name="arch" type="xml">
            <form string="Checklist">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. New Client Onboarding"/>
                        </h1>
                    </div>
                    <group>
                        <field name="description" placeholder="What this checklist is for..."/>
                        <field name="line_count"/>
                        <field name="active" invisible="1"/>
                    </group>
                    <notebook>
                        <page string="Steps" name="steps">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="project_checklist_template_view_search" model="ir.ui.view">
        <field name="name">project.checklist.template.search</field>
        <field name="model">project.checklist.template</field>
        <field name="arch" type="xml">
            <search string="Checklists">
                <field name="name"/>
                <field name="line_ids" string="Step" filter_domain="[('line_ids.name', 'ilike', self)]"/>
                <filter string="Archived" name="archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="project_checklist_template_action" model="ir.actions.act_window">
        <field name="name">Checklists</field>
        <field name="res_model">project.checklist.template</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first reusable checklist</p>
            <p>A checklist is a list of steps you can apply to any task in one click.</p>
        </field>
    </record>

    <menuitem id="project_checklist_template_menu"
              name="Checklists"
              parent="project.menu_project_config"
              action="project_checklist_template_action"
              groups="base.group_user"
              sequence="30"/>

</odoo>
