<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Task checklist steps must never be visible beyond the task they belong
        to. These rules mirror project.task's own visibility: regular internal
        users see steps of tasks they follow (or of non-"followers"-private
        projects), while Project Managers see everything.
    -->
    <record id="rule_task_checklist_line_user" model="ir.rule">
        <field name="name">Task Checklist Step: follow task visibility</field>
        <field name="model_id" ref="model_project_task_checklist_line"/>
        <field name="groups" eval="[Command.link(ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
        <field name="domain_force">
            ['|',
                ('task_id.project_id.privacy_visibility', '!=', 'followers'),
                ('task_id.message_partner_ids', 'in', [user.partner_id.id])]
        </field>
    </record>

    <record id="rule_task_checklist_line_manager" model="ir.rule">
        <field name="name">Task Checklist Step: manager sees all</field>
        <field name="model_id" ref="model_project_task_checklist_line"/>
        <field name="groups" eval="[Command.link(ref('project.group_project_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

</odoo>
