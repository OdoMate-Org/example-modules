msgstr "Пошук застосунків..."

#. module: app_dashboard
#. odoo-javascript
#: code:addons/app_dashboard/static/src/js/apps_dashboard.js:0
msgid "This app is no longer available to you."
msgstr "Цей застосунок більше вам не доступний."

#. module: app_dashboard
#. odoo-javascript
#: code:addons/app_dashboard/static/src/xml/apps_dashboard.xml:0
msgid "You do not have access to any application. Ask your administrator to grant you access rights."
msgstr "У вас немає доступу до жодного застосунку. Зверніться до адміністратора, щоб отримати права доступу."

#. module: app_dashboard
#: model:ir.model.fields,field_description:app_dashboard.field_app_dashboard_priority_app__menu_id
msgid "App"
msgstr "Застосунок"

#. module: app_dashboard
#: model:ir.model.fields,field_description:app_dashboard.field_res_config_settings__app_dashboard_default_home_screen
msgid "Apps Dashboard is the default home screen"
msgstr "Панель застосунків є типовим головним екраном"

#. module: app_dashboard
#: model_terms:ir.ui.view,arch_db:app_dashboard.res_config_settings_view_form_app_dashboard
msgid "Apps shown first, in this order, on everyone's My Apps dashboard."
msgstr "Застосунки, що показуються першими, у цьому порядку, на панелі «Мої застосунки» кожного користувача."

#. module: app_dashboard
#: model_terms:ir.ui.view,arch_db:app_dashboard.res_config_settings_view_form_app_dashboard
msgid "Default Home Screen"
msgstr "Типовий головний екран"

#. module: app_dashboard
#: model:ir.model.fields,help:app_dashboard.field_res_config_settings__app_dashboard_default_home_screen
#: model_terms:ir.ui.view,arch_db:app_dashboard.res_config_settings_view_form_app_dashboard
msgid "Every user lands on the My Apps dashboard right after logging in, instead of the default menu. Each person can still switch back from their own Preferences."
msgstr "Кожен користувач потрапляє на панель «Мої застосунки» одразу після входу, замість стандартного меню. Кожен може повернутися до стандартного меню зі своїх особистих налаштувань."

#. module: app_dashboard
#: model_terms:ir.ui.view,arch_db:app_dashboard.res_config_settings_view_form_app_dashboard
msgid "Manage Priority Apps"
msgstr "Керувати пріоритетними застосунками"

#. module: app_dashboard
#: model_terms:ir.ui.view,arch_db:app_dashboard.res_config_settings_view_form_app_dashboard
msgid "My Apps Dashboard"
msgstr "Панель «Мої застосунки»"

#. module: app_dashboard
#: model:ir.model,name:app_dashboard.model_app_dashboard_tile
msgid "My Apps Dashboard: Per-User Tile State"
msgstr "Панель «Мої застосунки»: стан плитки користувача"

#. module: app_dashboard
#: model:ir.model,name:app_dashboard.model_app_dashboard_priority_app
msgid "My Apps Dashboard: Priority App"
msgstr "Панель «Мої застосунки»: пріоритетний застосунок"

#. module: app_dashboard
#: model:ir.actions.act_window,name:app_dashboard.action_app_dashboard_priority_app
#: model_terms:ir.ui.view,arch_db:app_dashboard.res_config_settings_view_form_app_dashboard
#: model_terms:ir.ui.view,arch_db:app_dashboard.view_app_dashboard_priority_app_list
