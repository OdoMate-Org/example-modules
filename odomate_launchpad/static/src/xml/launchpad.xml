<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="odomate_launchpad.Launchpad">
        <div class="o_action o_odomate_launchpad h-100 overflow-auto">
            <div class="o_odomate_launchpad_bar d-flex flex-wrap align-items-center gap-2 px-3 py-3">
                <div class="o_odomate_launchpad_search input-group flex-grow-1">
                    <span class="input-group-text"><i class="oi" data-icon="search" aria-hidden="true"/></span>
                    <input type="search" class="form-control" t-ref="this.searchInput" t-att-value="this.state.query" t-on-input="this.onSearchInput" t-on-keydown="this.onSearchKeydown" placeholder="Search apps..." aria-label="Search apps"/>
                </div>
                <button t-if="!this.state.isHome" type="button" class="btn btn-primary o_odomate_launchpad_set_home" t-on-click="this.setAsHome">
                    <i class="oi me-1" data-icon="home" aria-hidden="true"/>
                    <span>Set as Startup Screen</span>
                </button>
                <button t-else="" type="button" class="btn btn-secondary o_odomate_launchpad_reset_home" t-on-click="this.resetHome" title="Stop opening Launchpad after login">
                    <i class="oi me-1" data-icon="check" aria-hidden="true"/>
                    <span>Startup Screen</span>
                </button>
            </div>

            <div t-if="!this.state.loading and !this.visibleTiles.length" class="o_odomate_launchpad_empty text-center text-muted py-5">
                <t t-if="this.state.query">No app matches your search.</t>
                <t t-else="">No apps are available to you.</t>
            </div>

            <div class="o_odomate_launchpad_grid px-2 pb-4">
                <div t-foreach="this.visibleTiles" t-as="tile" t-key="tile.id" class="o_odomate_launchpad_tile position-relative" t-att-class="{'o_odomate_launchpad_tile_pinned': tile.pinned}">
                    <a href="#" role="button" class="o_app o_odomate_launchpad_app d-flex flex-column align-items-center text-decoration-none" t-att-data-menu-xmlid="tile.xmlid" t-att-title="this.usageTitle(tile)" t-on-click.prevent="() => this.openApp(tile)">
                        <img t-if="tile.imageSrc" class="o_odomate_launchpad_icon" t-att-src="tile.imageSrc" t-att-alt="tile.name"/>
                        <div t-elif="tile.fontIcon" class="o_odomate_launchpad_icon d-flex align-items-center justify-content-center" t-att-style="tile.fontIcon.style">
                            <i class="oi" t-att-data-icon="tile.fontIcon.iconClass" aria-hidden="true"/>
                        </div>
                        <div t-else="" class="o_odomate_launchpad_icon o_odomate_launchpad_icon_letter d-flex align-items-center justify-content-center" t-out="tile.initial"/>
                        <span class="o_odomate_launchpad_caption mt-2 text-center" t-out="tile.name"/>
                    </a>
                    <button type="button" class="btn btn-link o_odomate_launchpad_pin" t-att-class="{'o_odomate_launchpad_pin_active': tile.pinned}" t-att-title="this.pinTitle(tile)" t-att-aria-label="this.pinTitle(tile)" t-att-aria-pressed="tile.pinned ? 'true' : 'false'" t-on-click.stop="() => this.togglePin(tile)">
                        <i class="oi" data-icon="push_pin" aria-hidden="true"/>
                    </button>
                </div>
            </div>
        </div>
    </t>
</templates>
