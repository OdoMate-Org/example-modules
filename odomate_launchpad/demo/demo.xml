<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">
    <!-- Discuss: opened often by the admin over the last weeks -->
    <record id="demo_usage_discuss_01" model="odomate.launchpad.usage">
        <field name="user_id" ref="base.user_admin"/>
        <field name="menu_id" ref="mail.menu_root_discuss"/>
        <field name="used_on" eval="(DateTime.now() - relativedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
    </record>
    <record id="demo_usage_discuss_02" model="odomate.launchpad.usage">
        <field name="user_id" ref="base.user_admin"/>
        <field name="menu_id" ref="mail.menu_root_discuss"/>
        <field name="used_on" eval="(DateTime.now() - relativedelta(days=4)).strftime('%Y-%m-%d %H:%M:%S')"/>
    </record>
    <record id="demo_usage_discuss_03" model="odomate.launchpad.usage">
        <field name="user_id" ref="base.user_admin"/>
        <field name="menu_id" ref="mail.menu_root_discuss"/>
        <field name="used_on" eval="(DateTime.now() - relativedelta(days=11)).strftime('%Y-%m-%d %H:%M:%S')"/>
    </record>
    <record id="demo_usage_discuss_04" model="odomate.launchpad.usage">
        <field name="user_id" ref="base.user_admin"/>
        <field name="menu_id" ref="mail.menu_root_discuss"/>
        <field name="used_on" eval="(DateTime.now() - relativedelta(days=19)).strftime('%Y-%m-%d %H:%M:%S')"/>
    </record>

    <!-- Settings: occasional use, plus one open outside the 30-day window -->
    <record id="demo_usage_settings_01" model="odomate.launchpad.usage">
        <field name="user_id" ref="base.user_admin"/>
        <field name="menu_id" ref="base.menu_administration"/>
        <field name="used_on" eval="(DateTime.now() - relativedelta(days=6)).strftime('%Y-%m-%d %H:%M:%S')"/>
    </record>
    <record id="demo_usage_settings_02" model="odomate.launchpad.usage">
        <field name="user_id" ref="base.user_admin"/>
        <field name="menu_id" ref="base.menu_administration"/>
        <field name="used_on" eval="(DateTime.now() - relativedelta(days=45)).strftime('%Y-%m-%d %H:%M:%S')"/>
    </record>

    <!-- Projects, Timesheets, Employees, Expenses, Recruitment: only when those apps are installed.
         Projects and Timesheets are also pinned for the admin. -->
    <function model="odomate.launchpad.usage" name="_load_demo_usage"/>
</odoo>
