<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Starter watch rules: all left in Draft so nothing is recorded until confirmed -->
    <record id="demo_rule_contacts" model="audit.rule">
        <field name="name">Contacts</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="company_id" ref="base.main_company"/>
        <field name="detail_level">full</field>
        <field name="track_read" eval="False"/>
        <field name="keep_deleted_copy" eval="True"/>
    </record>
    <record id="demo_rule_bank_accounts" model="audit.rule">
        <field name="name">Bank Accounts</field>
        <field name="model_id" ref="base.model_res_partner_bank"/>
        <field name="company_id" ref="base.main_company"/>
        <field name="detail_level">full</field>
        <field name="track_read" eval="False"/>
        <field name="keep_deleted_copy" eval="True"/>
    </record>
    <record id="demo_rule_price_lists" model="audit.rule">
        <field name="name">Price Lists</field>
        <field name="model_id" ref="product.model_product_pricelist"/>
        <field name="company_id" ref="base.main_company"/>
        <field name="detail_level">full</field>
        <field name="track_read" eval="False"/>
        <field name="keep_deleted_copy" eval="True"/>
    </record>

    <!-- Watched demo records the illustrative history points at -->
    <record id="demo_bank_deco_addict" model="res.partner.bank">
