<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="group_audit_user" model="res.groups">
        <field name="name">Auditor</field>
        <field name="comment">Read-only access to the recorded audit trail and to the watch rules.</field>
    </record>

    <record id="group_audit_manager" model="res.groups">
        <field name="name">Audit Administrator</field>
        <field name="comment">Defines what is watched, and may delete recorded history.</field>
        <field name="implied_ids" eval="[(4, ref('group_audit_user'))]"/>
    </record>

    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_audit_manager'))]"/>
    </record>

    <record id="base.user_admin" model="res.users">
        <field name="group_ids" eval="[(4, ref('group_audit_manager'))]"/>
    </record>

    <record id="audit_rule_company_rule" model="ir.rule">
        <field name="name">Audit Rule: multi-company</field>
        <field name="model_id" ref="model_audit_rule"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="audit_log_company_rule" model="ir.rule">
        <field name="name">Audit Log: multi-company</field>
        <field name="model_id" ref="model_audit_log"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="audit_log_line_company_rule" model="ir.rule">
        <field name="name">Audit Log Line: multi-company</field>
        <field name="model_id" ref="model_audit_log_line"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="audit_session_company_rule" model="ir.rule">
        <field name="name">Audit Session: multi-company</field>
        <field name="model_id" ref="model_audit_session"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="audit_page_action_company_rule" model="ir.rule">
        <field name="name">Audit Screen: multi-company</field>
        <field name="model_id" ref="model_audit_page_action"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
