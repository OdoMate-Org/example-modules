<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_audit_session_list" model="ir.ui.view">
        <field name="name">audit.session.list</field>
        <field name="model">audit.session</field>
        <field name="arch" type="xml">
            <list string="Sessions" create="false" edit="false">
                <field name="user_id"/>
                <field name="start_datetime"/>
                <field name="last_activity_datetime"/>
                <field name="log_count" string="Events"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_audit_session_form" model="ir.ui.view">
        <field name="name">audit.session.form</field>
        <field name="model">audit.session</field>
        <field name="arch" type="xml">
            <form string="Session" create="false" edit="false">
                <header>
                    <button name="action_view_logs" type="object" string="View Logs"
                            class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="user_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="start_datetime"/>
                            <field name="last_activity_datetime"/>
                            <field name="log_count" string="Events"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Screens Visited" name="screens">
                            <field name="page_action_ids" nolabel="1">
                                <list string="Screens" create="false" edit="false" delete="false">
                                    <field name="name"/>
                                    <field name="res_model"/>
                                </list>
                            </field>
                        </page>
                        <page string="Events" name="events">
                            <field name="log_ids" nolabel="1">
                                <list string="Events" create="false" edit="false" delete="false">
                                    <field name="date"/>
                                    <field name="record_name"/>
                                    <field name="res_model"/>
                                    <field name="action"/>
                                    <field name="page_action_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_audit_session_search" model="ir.ui.view">
        <field name="name">audit.session.search</field>
        <field name="model">audit.session</field>
        <field name="arch" type="xml">
            <search string="Sessions">
                <field name="user_id"/>
                <field name="start_datetime"/>
                <separator/>
                <filter name="group_by_user" string="User" context="{'group_by': 'user_id'}"/>
                <filter name="group_by_day" string="Day"
                        context="{'group_by': 'start_datetime:day'}"/>
            </search>
        </field>
    </record>

    <record id="action_audit_session" model="ir.actions.act_window">
        <field name="name">Sessions</field>
        <field name="res_model">audit.session</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_audit_session_search"/>
        <field name="context">{'search_default_group_by_user': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No session recorded yet</p>
            <p>
                A session groups everything one user did against watched records
                until they stopped for longer than the inactivity timeout.
            </p>
        </field>
    </record>

</odoo>
