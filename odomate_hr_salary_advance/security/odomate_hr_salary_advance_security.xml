<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="odomate_hr_salary_advance_rule_company" model="ir.rule">
        <field name="name">Salary Advance: multi-company</field>
        <field name="model_id" ref="model_odomate_hr_salary_advance"/>
        <field name="global" eval="True"/>
        <field name="domain_force">
            ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
        </field>
    </record>

    <record id="odomate_hr_salary_advance_rule_hr_officer" model="ir.rule">
        <field name="name">Salary Advance: HR officers see every request</field>
        <field name="model_id" ref="model_odomate_hr_salary_advance"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="odomate_hr_salary_advance_rule_own" model="ir.rule">
        <field name="name">Salary Advance: employees read their own requests</field>
        <field name="model_id" ref="model_odomate_hr_salary_advance"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

</odoo>
