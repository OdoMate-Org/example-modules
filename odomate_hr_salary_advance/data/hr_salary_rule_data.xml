<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- The rule is shipped but deliberately NOT attached to any salary
         structure: which structures should carry the deduction is a customer
         decision, made once from Payroll > Configuration > Salary Structures.
         Its category is resolved by the module's post_init_hook, because
         payroll.DED only exists in the payroll module's demo data. -->
    <record id="hr_salary_rule_advance_deduction" model="hr.salary.rule">
        <field name="name">Salary Advance Deduction</field>
        <field name="code">ADV_DEDUCT</field>
        <field name="sequence">180</field>
        <field name="appears_on_payslip" eval="True"/>
        <field name="condition_select">python</field>
        <field name="condition_python">total = 0.0
for line in payslip.input_line_ids:
    if line.code == 'ADV_DEDUCT':
        total += line.amount
result = total != 0.0</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">total = 0.0
for line in payslip.input_line_ids:
    if line.code == 'ADV_DEDUCT':
        total += line.amount
result = -total</field>
        <field name="company_id" eval="False"/>
        <field name="note">Recovers the outstanding balance of salary advances disbursed to the employee. Fed by the ADV_DEDUCT payslip input generated by the Employee Salary Advance module.</field>
    </record>

    <record id="hr_rule_input_advance_deduction" model="hr.rule.input">
        <field name="name">Salary Advance Deduction</field>
        <field name="code">ADV_DEDUCT</field>
        <field name="input_id" ref="hr_salary_rule_advance_deduction"/>
    </record>

</odoo>
