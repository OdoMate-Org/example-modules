<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">

        <record id="demo_document_type_work_permit" model="odomate.hr.document.type">
            <field name="name">Work permit</field>
            <field name="reminder_days">60</field>
            <field name="chasing_pattern">before_expiry</field>
        </record>

        <record id="demo_document_type_first_aid" model="odomate.hr.document.type">
            <field name="name">First-aid certificate</field>
            <field name="reminder_days">14</field>
            <field name="chasing_pattern">before_expiry</field>
        </record>

        <record id="demo_document_type_driving_licence" model="odomate.hr.document.type">
            <field name="name">Driving licence</field>
            <field name="reminder_days">21</field>
            <field name="chasing_pattern">daily_before</field>
        </record>

        <record id="demo_document_type_forklift" model="odomate.hr.document.type">
            <field name="name">Forklift certificate</field>
            <field name="reminder_days">7</field>
            <field name="chasing_pattern">daily_after</field>
        </record>

        <record id="demo_document_type_residence_permit" model="odomate.hr.document.type">
            <field name="name">Residence permit</field>
            <field name="reminder_days">0</field>
            <field name="chasing_pattern">on_expiry</field>
        </record>

        <record id="demo_document_type_professional_licence" model="odomate.hr.document.type">
            <field name="name">Professional licence</field>
            <field name="reminder_days">30</field>
            <field name="chasing_pattern">before_expiry</field>
        </record>

        <record id="demo_form_template_expense_claim" model="odomate.hr.form.template">
            <field name="name">Expense claim form</field>
            <field name="note">Print, complete and return to HR with the original receipts attached. One form per calendar month.</field>
        </record>

        <record id="demo_form_template_address_change" model="odomate.hr.form.template">
            <field name="name">Change of address notification</field>
            <field name="note">Use this form whenever your home address changes. HR updates payroll and the emergency contact list from it.</field>
        </record>

        <record id="demo_form_template_equipment_loan" model="odomate.hr.form.template">
            <field name="name">Equipment loan agreement</field>
            <field name="note">Signed when a laptop, phone or vehicle is handed over. Return the equipment with a countersigned copy.</field>
        </record>

        <function model="odomate.hr.document" name="_generate_demo_documents"/>

    </data>
</odoo>
