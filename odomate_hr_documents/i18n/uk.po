#. module: odomate_hr_documents
#. odoo-python
#: code:addons/odomate_hr_documents/models/odomate_hr_document.py:0
msgid ""
"%(employee)s already holds a valid %(document_type)s. Renew the existing "
"document instead of adding a second one."
msgstr ""
"%(employee)s вже має дійсний документ типу «%(document_type)s». Оновіть "
"наявний документ замість створення другого."

#. module: odomate_hr_documents
#. odoo-python
#: code:addons/odomate_hr_documents/models/odomate_hr_document.py:0
msgid ""
"%(reference)s expired on %(date)s and cannot be marked valid. Use Renew to "
"record a new issue and expiry date."
msgstr ""
"%(reference)s втратив чинність %(date)s, тому його не можна позначити "
"дійсним. Скористайтеся кнопкою «Оновити», щоб внести нові дати видачі та "
"закінчення."

#. module: odomate_hr_documents
#. odoo-python
#: code:addons/odomate_hr_documents/models/odomate_hr_document.py:0
msgid ""
"%(reference)s is still a draft, so it is not chased. Mark it valid first."
msgstr ""
"%(reference)s ще є чернеткою, тому нагадування не надсилаються. Спершу "
"позначте його дійсним."
