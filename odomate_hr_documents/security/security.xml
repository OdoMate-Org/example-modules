<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_odomate_hr_document_company" model="ir.rule">
        <field name="name">Employee Document: multi-company</field>
        <field name="model_id" ref="model_odomate_hr_document"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(5, 0, 0)]"/>
    </record>

    <record id="rule_odomate_hr_document_own" model="ir.rule">
        <field name="name">Employee Document: own documents (read only)</field>
        <field name="model_id" ref="model_odomate_hr_document"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_odomate_hr_document_hr" model="ir.rule">
        <field name="name">Employee Document: HR officers see all</field>
        <field name="model_id" ref="model_odomate_hr_document"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
    </record>

    <record id="rule_odomate_hr_document_history_company" model="ir.rule">
        <field name="name">Document Renewal History: multi-company</field>
        <field name="model_id" ref="model_odomate_hr_document_history"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(5, 0, 0)]"/>
    </record>

    <record id="rule_odomate_hr_document_history_own" model="ir.rule">
        <field name="name">Document Renewal History: own documents (read only)</field>
        <field name="model_id" ref="model_odomate_hr_document_history"/>
        <field name="domain_force">[('document_id.employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_odomate_hr_document_history_hr" model="ir.rule">
        <field name="name">Document Renewal History: HR officers see all</field>
        <field name="model_id" ref="model_odomate_hr_document_history"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
    </record>
</odoo>
