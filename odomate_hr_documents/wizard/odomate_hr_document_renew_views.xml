<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_odomate_hr_document_renew_form" model="ir.ui.view">
        <field name="name">odomate.hr.document.renew.form</field>
        <field name="model">odomate.hr.document.renew</field>
        <field name="arch" type="xml">
            <form string="Renew Document">
                <group>
                    <field name="document_id" invisible="1"/>
                    <field name="new_date_issued"/>
                    <field name="new_date_expiry"/>
                    <field name="new_attachment_ids" widget="many2many_binary"
                           string="New Scan(s)"/>
                    <field name="reason" placeholder="e.g. Renewed at the town hall on 3 March"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Renew"
                            class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_odomate_hr_document_renew" model="ir.actions.act_window">
        <field name="name">Renew Document</field>
        <field name="res_model">odomate.hr.document.renew</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" eval="False"/>
    </record>
</odoo>
