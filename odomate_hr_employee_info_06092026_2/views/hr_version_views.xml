<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_version_view_form_odomate_notice_period" model="ir.ui.view">
        <field name="name">hr.version.form.odomate.notice.period</field>
        <field name="model">hr.version</field>
        <field name="inherit_id" ref="hr.hr_contract_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='contract']" position="inside">
                <field name="odomate_notice_period_editable" invisible="1"/>
                <field name="notice_period" readonly="not odomate_notice_period_editable"/>
            </xpath>
        </field>
    </record>

</odoo>
