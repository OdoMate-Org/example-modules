#: model_terms:ir.ui.view,arch_db:odomate_hr_employee_info_06092026_2.res_config_settings_view_form_odomate_employee_info
msgid ""
"Create an employee record automatically for every new internal user of this "
"company."
msgstr ""
"Автоматично створювати запис співробітника для кожного нового внутрішнього "
"користувача цієї компанії."

#. module: odomate_hr_employee_info_06092026_2
#: model:ir.model.fields,help:odomate_hr_employee_info_06092026_2.field_res_company__hr_auto_create_employee
#: model:ir.model.fields,help:odomate_hr_employee_info_06092026_2.field_res_config_settings__hr_auto_create_employee
msgid ""
"Create an employee record automatically for every new internal user of this "
"company. Evaluated when the login is created; existing logins are never "
"touched, and removing a login never deletes its employee."
msgstr ""
"Автоматично створювати запис співробітника для кожного нового внутрішнього "
"користувача цієї компанії. Перевіряється в момент створення облікового "
"запису; наявні облікові записи ніколи не змінюються, а видалення облікового "
"запису ніколи не видаляє співробітника."

