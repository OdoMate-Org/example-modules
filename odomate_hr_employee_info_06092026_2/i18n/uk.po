#. module: odomate_hr_employee_info_06092026_2
#: model:mail.template,body_html:odomate_hr_employee_info_06092026_2.mail_template_identification_expiry
msgid "<div style=\"margin: 0px; padding: 0px; font-size: 13px;\"><p>Dear <t t-out=\"object.name\">Employee</t>,</p><p>Your identification document <t t-out=\"object.identification_id\">ID-0000</t> expires on <t t-out=\"object.identification_expiry_date\">01/01/2026</t>.</p><p>Please start the renewal now and send the new document to the HR department so that your employee file stays up to date.</p><p>Kind regards,</p><p><t t-out=\"object.company_id.name\">Your Company</t> HR Department</p></div>"
msgstr "<div style=\"margin: 0px; padding: 0px; font-size: 13px;\"><p>Шановний(-а) <t t-out=\"object.name\">Employee</t>,</p><p>Дія вашого посвідчення особи <t t-out=\"object.identification_id\">ID-0000</t> завершується <t t-out=\"object.identification_expiry_date\">01/01/2026</t>.</p><p>Будь ласка, розпочніть оновлення вже зараз і надішліть новий документ до відділу кадрів, щоб ваша особова справа залишалася актуальною.</p><p>З повагою,</p><p>Відділ кадрів <t t-out=\"object.company_id.name\">Your Company</t></p></div>"

#. module: odomate_hr_employee_info_06092026_2
#: model:mail.template,subject:odomate_hr_employee_info_06092026_2.mail_template_passport_expiry
msgid "Your passport expires on {{ object.passport_expiration_date }}"
msgstr "Дія вашого закордонного паспорта завершується {{ object.passport_expiration_date }}"

#. module: odomate_hr_employee_info_06092026_2
#: model:mail.template,body_html:odomate_hr_employee_info_06092026_2.mail_template_passport_expiry
msgid "<div style=\"margin: 0px; padding: 0px; font-size: 13px;\"><p>Dear <t t-out=\"object.name\">Employee</t>,</p><p>Your passport <t t-out=\"object.passport_id\">P-0000</t> expires on <t t-out=\"object.passport_expiration_date\">01/01/2026</t>.</p><p>Passport renewal often takes several months. Please begin the process now and send the renewed passport to the HR department.</p><p>Kind regards,</p><p><t t-out=\"object.company_id.name\">Your Company</t> HR Department</p></div>"
msgstr "<div style=\"margin: 0px; padding: 0px; font-size: 13px;\"><p>Шановний(-а) <t t-out=\"object.name\">Employee</t>,</p><p>Дія вашого закордонного паспорта <t t-out=\"object.passport_id\">P-0000</t> завершується <t t-out=\"object.passport_expiration_date\">01/01/2026</t>.</p><p>Оформлення нового закордонного паспорта часто триває кілька місяців. Будь ласка, розпочніть процес зараз і надішліть оновлений паспорт до відділу кадрів.</p><p>З повагою,</p><p>Відділ кадрів <t t-out=\"object.company_id.name\">Your Company</t></p></div>"

