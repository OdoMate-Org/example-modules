<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="odomate_hr_dependant_rule_company" model="ir.rule">
        <field name="name">Employee Dependant: multi-company</field>
        <field name="model_id" ref="model_odomate_hr_dependant"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <record id="odomate_hr_dependant_rule_hr_user" model="ir.rule">
        <field name="name">Employee Dependant: HR officers and administrators</field>
        <field name="model_id" ref="model_odomate_hr_dependant"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
    </record>

    <record id="odomate_hr_dependant_rule_own" model="ir.rule">
        <field name="name">Employee Dependant: own records only</field>
        <field name="model_id" ref="model_odomate_hr_dependant"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

</odoo>
