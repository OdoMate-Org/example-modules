<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="ir_cron_odomate_hr_identity_expiry" model="ir.cron">
        <field name="name">HR: Identity Document Expiry Warnings</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="state">code</field>
        <field name="code">model._odomate_cron_identity_expiry_warnings()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.today() + timedelta(days=1)).strftime('%Y-%m-%d 05:00:00')"/>
        <field name="active" eval="True"/>
    </record>

</odoo>
