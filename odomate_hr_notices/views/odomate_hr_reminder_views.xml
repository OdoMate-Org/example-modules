<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_odomate_hr_reminder_list" model="ir.ui.view">
        <field name="name">odomate.hr.reminder.list</field>
        <field name="model">odomate.hr.reminder</field>
        <field name="arch" type="xml">
            <list string="Date Reminders">
                <field name="name"/>
                <field name="model_id"/>
                <field name="field_id"/>
                <field name="window"/>
                <field name="preview_count" string="Matching"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_odomate_hr_reminder_form" model="ir.ui.view">
        <field name="name">odomate.hr.reminder.form</field>
        <field name="model">odomate.hr.reminder</field>
        <field name="arch" type="xml">
            <form string="Date Reminder">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_matching_records" type="object"
                                class="oe_stat_button" icon="fa-calendar-check-o">
                            <field name="preview_count" widget="statinfo" string="Matching"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Work permits expiring soon"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="model_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="field_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="window"/>
                            <field name="days_ahead" invisible="window != 'days_ahead'"
                                   required="window == 'days_ahead'"/>
                            <field name="date_from" invisible="window != 'period'"
                                   required="window == 'period'"/>
                            <field name="date_to" invisible="window != 'period'"
                                   required="window == 'period'"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <div class="text-muted">
                        A reminder answers a date question only. It never filters on an
                        amount, a state or a status.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_odomate_hr_reminder_search" model="ir.ui.view">
        <field name="name">odomate.hr.reminder.search</field>
        <field name="model">odomate.hr.reminder</field>
        <field name="arch" type="xml">
            <search string="Date Reminders">
                <field name="name"/>
                <field name="model_id"/>
                <filter name="filter_inactive" string="Archived" domain="[('active', '=', False)]"/>
                <separator/>
                <filter name="group_by_model" string="Model"
                        context="{'group_by': 'model_id'}"/>
                <filter name="group_by_window" string="Time Window"
                        context="{'group_by': 'window'}"/>
            </search>
        </field>
    </record>

    <record id="action_odomate_hr_reminder" model="ir.actions.act_window">
        <field name="name">Date Reminders</field>
        <field name="res_model">odomate.hr.reminder</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Save your first date reminder
            </p>
            <p>
                A reminder watches one date field on employees, contract versions,
                applicants or time off, and counts the records falling inside the
                time window you choose.
            </p>
        </field>
    </record>

</odoo>
