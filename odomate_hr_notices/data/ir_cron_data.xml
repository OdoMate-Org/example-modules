<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_expire_announcements" model="ir.cron">
            <field name="name">HR Notices: Expire Published Announcements</field>
            <field name="model_id" ref="model_odomate_hr_announcement"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="state">code</field>
            <field name="code">model._cron_expire_announcements()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
            <field name="nextcall"
                   eval="(DateTime.now() + relativedelta(days=1, hour=0, minute=15, second=0, microsecond=0)).strftime('%Y-%m-%d %H:%M:%S')"/>
        </record>
    </data>
</odoo>
