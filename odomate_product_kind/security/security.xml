<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="group_odomate_product_kind_user" model="res.groups">
        <field name="name">Product Kind / User</field>
        <field name="comment">Can browse the Product Kind hierarchy and see the classification on documents.</field>
    </record>

    <record id="group_odomate_product_kind_manager" model="res.groups">
        <field name="name">Product Kind / Manager</field>
        <field name="comment">Full CRUD on the Product Kind catalog and the right to change frozen snapshots.</field>
        <field name="implied_ids" eval="[(4, ref('group_odomate_product_kind_user'))]"/>
    </record>

    <!-- Grant the admin user the Manager group by default so the module is
         usable (menu visible, full access) immediately after install. -->
    <record id="base.user_admin" model="res.users">
        <field name="group_ids" eval="[(4, ref('group_odomate_product_kind_manager'))]"/>
    </record>

    <!-- Global multi-company record rule: a user sees global (company-less)
         kinds plus the kinds of every company they are allowed into. -->
    <record id="odomate_product_kind_company_rule" model="ir.rule">
        <field name="name">Product Kind: multi-company</field>
        <field name="model_id" ref="model_odomate_product_kind"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
