<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="mrp_production_form_view_odomate_kind" model="ir.ui.view">
        <field name="name">mrp.production.form.odomate.product.kind</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <field name="product_id" position="after">
                <!-- Snapshot is frozen at MO creation. Readonly for everyone,
                     editable only for a Product Kind Manager (group-dependent
                     modifier so the form never blocks what the model allows). -->
                <field name="odomate_product_kind_snapshot_id"
                       groups="!odomate_product_kind.group_odomate_product_kind_manager"
                       readonly="1"/>
                <field name="odomate_product_kind_snapshot_id"
                       groups="odomate_product_kind.group_odomate_product_kind_manager"/>
                <field name="odomate_route_type_snapshot" readonly="1"/>
            </field>
        </field>
    </record>

</odoo>
