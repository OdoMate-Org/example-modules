<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="mrp_bom_form_view_odomate_kind" model="ir.ui.view">
        <field name="name">mrp.bom.form.odomate.product.kind</field>
        <field name="model">mrp.bom</field>
        <field name="inherit_id" ref="mrp.mrp_bom_form_view"/>
        <field name="arch" type="xml">
            <field name="product_tmpl_id" position="after">
                <field name="odomate_product_kind_id" readonly="1"/>
            </field>
        </field>
    </record>

    <record id="mrp_bom_search_view_odomate_kind" model="ir.ui.view">
        <field name="name">mrp.bom.search.odomate.product.kind</field>
        <field name="model">mrp.bom</field>
        <field name="inherit_id" ref="mrp.view_mrp_bom_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <filter name="group_odomate_product_kind" string="Product Kind"
                        context="{'group_by': 'odomate_product_kind_id'}"/>
            </xpath>
        </field>
    </record>

</odoo>
