<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================ HIERARCHY ============================ -->
    <record id="odomate_product_kind_view_hierarchy" model="ir.ui.view">
        <field name="name">odomate.product.kind.hierarchy</field>
        <field name="model">odomate.product.kind</field>
        <field name="arch" type="xml">
            <hierarchy string="Product Kinds">
                <field name="parent_id"/>
                <field name="route_type"/>
                <field name="color"/>
                <templates>
                    <t t-name="hierarchy-box">
                        <div t-attf-class="o_hierarchy_node_header d-flex align-items-center o_kanban_color_#{record.color.raw_value}">
                            <span class="o_hierarchy_node_color_dot me-1" style="display:inline-block;width:10px;height:10px;border-radius:50%;background-color:currentColor;"/>
                            <field name="name" class="fw-bold"/>
                        </div>
                        <div class="o_hierarchy_node_body">
                            <field name="route_type" widget="badge"/>
                            <div t-if="record.code.value" class="text-muted small">
                                <field name="code"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </hierarchy>
        </field>
    </record>

    <!-- ============================== LIST =============================== -->
    <record id="odomate_product_kind_view_list" model="ir.ui.view">
        <field name="name">odomate.product.kind.list</field>
        <field name="model">odomate.product.kind</field>
        <field name="arch" type="xml">
            <list string="Product Kinds">
                <field name="sequence" widget="handle"/>
                <field name="complete_name" string="Product Kind"/>
                <field name="code" optional="show"/>
                <field name="sequence_code" optional="hide"/>
                <field name="route_type"/>
                <field name="manufacturing_mode" optional="show"/>
                <field name="requires_engineering" optional="hide"/>
                <field name="requires_team_planning" optional="hide"/>
                <field name="company_id" optional="show" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- ============================= KANBAN ============================== -->
    <record id="odomate_product_kind_view_kanban" model="ir.ui.view">
        <field name="name">odomate.product.kind.kanban</field>
        <field name="model">odomate.product.kind</field>
        <field name="arch" type="xml">
            <kanban default_group_by="parent_id" class="o_kanban_small_column">
                <field name="color"/>
                <field name="product_count"/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="oe_kanban_global_click oe_kanban_card o_kanban_color_#{record.color.raw_value}">
                            <div class="o_kanban_record_top">
                                <strong class="o_kanban_record_title">
                                    <field name="complete_name"/>
                                </strong>
                                <div class="o_dropdown_kanban dropdown" groups="odomate_product_kind.group_odomate_product_kind_manager">
                                    <a role="button" class="dropdown-toggle o-no-caret btn" data-bs-toggle="dropdown" href="#" aria-label="Dropdown menu" title="Dropdown menu">
                                        <span class="fa fa-ellipsis-v"/>
                                    </a>
                                    <div class="dropdown-menu" role="menu">
                                        <ul class="oe_kanban_colorpicker" data-field="color" role="menu"/>
                                    </div>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <span t-if="record.code.value" class="text-muted">
                                    <field name="code"/>
                                </span>
                                <field name="manufacturing_mode" widget="badge"/>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <span class="badge text-bg-info">
                                    <field name="product_count"/> Products
                                </span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ============================== FORM =============================== -->
    <record id="odomate_product_kind_view_form" model="ir.ui.view">
        <field name="name">odomate.product.kind.form</field>
        <field name="model">odomate.product.kind</field>
        <field name="arch" type="xml">
            <form string="Product Kind">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button type="object" name="action_view_products" class="oe_stat_button" icon="fa-cubes">
                            <field name="product_count" widget="statinfo" string="Products"/>
                        </button>
                        <button type="object" name="action_view_boms" class="oe_stat_button" icon="fa-sitemap">
                            <field name="bom_count" widget="statinfo" string="BoMs"/>
                        </button>
                        <button type="object" name="action_view_sale_lines" class="oe_stat_button" icon="fa-dollar">
                            <field name="sale_line_count" widget="statinfo" string="Sale Lines"/>
                        </button>
                        <button type="object" name="action_view_productions" class="oe_stat_button" icon="fa-wrench">
                            <field name="mrp_production_count" widget="statinfo" string="Manufacturing"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Finished Goods"/></h1>
                        <field name="complete_name" invisible="not parent_id"/>
                    </div>
                    <group>
                        <group name="classification">
                            <field name="code"/>
                            <field name="sequence_code"/>
                            <field name="parent_id"/>
                            <field name="route_type"/>
                            <field name="manufacturing_mode"/>
                            <field name="sequence"/>
                        </group>
                        <group name="flags">
                            <field name="requires_engineering"/>
                            <field name="requires_team_planning"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="color" widget="color_picker"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Describe this Product Kind..."/>
                    <notebook>
                        <page string="Sub Kinds" name="children">
                            <field name="child_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="code"/>
                                    <field name="route_type"/>
                                    <field name="manufacturing_mode"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============================= SEARCH ============================== -->
    <record id="odomate_product_kind_view_search" model="ir.ui.view">
        <field name="name">odomate.product.kind.search</field>
        <field name="model">odomate.product.kind</field>
        <field name="arch" type="xml">
            <search string="Product Kinds">
                <field name="name" string="Product Kind" filter_domain="['|', ('name', 'ilike', self), ('code', 'ilike', self)]"/>
                <field name="parent_id"/>
                <filter name="filter_requires_engineering" string="Requires Engineering" domain="[('requires_engineering', '=', True)]"/>
                <filter name="filter_requires_team_planning" string="Requires Team Planning" domain="[('requires_team_planning', '=', True)]"/>
                <separator/>
                <filter name="filter_archived" string="Archived" domain="[('active', '=', False)]"/>
                <separator/>
                <filter name="group_parent" string="Parent" context="{'group_by': 'parent_id'}"/>
                <filter name="group_route_type" string="Route Type" context="{'group_by': 'route_type'}"/>
                <filter name="group_manufacturing_mode" string="Manufacturing Mode" context="{'group_by': 'manufacturing_mode'}"/>
            </search>
        </field>
    </record>

    <!-- ============================= ACTION ============================== -->
    <record id="odomate_product_kind_action" model="ir.actions.act_window">
        <field name="name">Product Kinds</field>
        <field name="res_model">odomate.product.kind</field>
        <field name="view_mode">hierarchy,list,kanban,form</field>
        <field name="search_view_id" ref="odomate_product_kind_view_search"/>
        <field name="context">{'search_default_group_parent': 0}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first Product Kind</p>
            <p>Product Kinds are a hierarchical manufacturing classification that flows
               from products through sales into manufacturing, with a frozen snapshot
               on confirmed documents.</p>
        </field>
    </record>

    <!-- ============================== MENUS ============================= -->
    <menuitem id="menu_odomate_product_kind_root"
              name="Product Kinds"
              parent="mrp.menu_mrp_configuration"
              action="odomate_product_kind_action"
              sequence="80"
              groups="group_odomate_product_kind_user"/>

</odoo>
