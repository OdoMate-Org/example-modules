<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">

        <record id="sale_order_full_auto" model="sale.order">
            <field name="partner_id" ref="base.res_partner_2"/>
            <field name="warehouse_id" ref="stock.warehouse0"/>
            <field name="client_order_ref">Scenario 1 - Main Warehouse, all three switches ON: ship + invoice + post</field>
            <field name="order_line" eval="[
                (0, 0, {'product_id': ref('product_standard_widget'), 'product_uom_qty': 5}),
                (0, 0, {'product_id': ref('product_office_chair'), 'product_uom_qty': 2}),
            ]"/>
        </record>

        <record id="sale_order_ship_only" model="sale.order">
            <field name="partner_id" ref="base.res_partner_4"/>
            <field name="warehouse_id" ref="stock.warehouse0"/>
            <field name="client_order_ref">Scenario 2 - leave only Ship Automatically ON before confirming</field>
            <field name="order_line" eval="[
                (0, 0, {'product_id': ref('product_standard_widget'), 'product_uom_qty': 12}),
            ]"/>
        </record>

        <record id="sale_order_invoice_only" model="sale.order">
            <field name="partner_id" ref="base.res_partner_10"/>
            <field name="warehouse_id" ref="stock.warehouse0"/>
            <field name="client_order_ref">Scenario 3a - leave only Create Invoice Automatically ON: ordered-quantity product is invoiced without any delivery</field>
            <field name="order_line" eval="[
                (0, 0, {'product_id': ref('product_office_chair'), 'product_uom_qty': 4}),
            ]"/>
        </record>

        <record id="sale_order_invoice_silent_skip" model="sale.order">
            <field name="partner_id" ref="base.res_partner_12"/>
            <field name="warehouse_id" ref="stock.warehouse0"/>
            <field name="client_order_ref">Scenario 3b - leave only Create Invoice Automatically ON: delivered-quantity product, nothing to invoice, skipped silently with a chatter note</field>
            <field name="order_line" eval="[
                (0, 0, {'product_id': ref('product_custom_fixture'), 'product_uom_qty': 2}),
            ]"/>
        </record>

        <record id="sale_order_manual_baseline" model="sale.order">
            <field name="partner_id" ref="base.res_partner_2"/>
            <field name="warehouse_id" ref="warehouse_project"/>
            <field name="client_order_ref">Scenario 4 - Project Warehouse, all switches OFF: standard manual Odoo behaviour</field>
            <field name="order_line" eval="[
                (0, 0, {'product_id': ref('product_standard_widget'), 'product_uom_qty': 6}),
            ]"/>
        </record>

        <record id="sale_order_negative_stock" model="sale.order">
            <field name="partner_id" ref="base.res_partner_10"/>
            <field name="warehouse_id" ref="stock.warehouse0"/>
            <field name="client_order_ref">Scenario 5 - Main Warehouse, all switches ON, zero on-hand: delivery is validated anyway and stock goes negative</field>
            <field name="order_line" eval="[
                (0, 0, {'product_id': ref('product_custom_fixture'), 'product_uom_qty': 10}),
            ]"/>
        </record>

    </data>
</odoo>
