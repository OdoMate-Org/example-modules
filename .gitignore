# Python bytecode — never belongs in a published Odoo addon. A .pyc compiled
# by one interpreter can shadow the source in an Odoo container running a
# different Python, so the installed code stops matching the code you read.
__pycache__/
*.py[cod]
*$py.class

# Packaging / build artefacts
*.egg-info/
build/
dist/
*.zip

# Editor and OS noise
.idea/
.vscode/
.DS_Store
*.swp

# OdoMate generator metadata. It rides in the stored archive because the
# enhancement flow reads it back, but it is not part of the addon: it carries
# the generation id and the author's original requirements verbatim. Anchored
# to a module root, so a module may still ship its own data/module_manifest.json
# — matching the filter the platform's push applies.
/*/module_manifest.json
