<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_general_ledger">
        <t t-call="web.html_container">
            <t t-call="web.internal_layout">
                <t t-call="odomate_account_ledger_reports.report_odomate_styles"/>
                <div class="page">
                    <h2 class="text-center">General Ledger</h2>
                    <t t-call="odomate_account_ledger_reports.report_filter_header">
                        <t t-set="company" t-value="header['company']"/>
                        <t t-set="date_from" t-value="header['date_from']"/>
                        <t t-set="date_to" t-value="header['date_to']"/>
                        <t t-set="journals" t-value="header['journals']"/>
                        <t t-set="target_move_label" t-value="header['target_move_label']"/>
                    </t>
                    <t t-set="ncols" t-value="9 + (1 if show_currency else 0) + (1 if show_analytic else 0)"/>
                    <table class="table table-sm o_odomate_table">
                        <thead>
                            <tr>
                                <th style="width: 8%;">Date</th>
                                <th style="width: 6%;">Journal</th>
                                <th style="width: 12%;">Partner</th>
                                <th style="width: 9%;">Reference</th>
                                <th style="width: 10%;">Entry</th>
                                <th style="width: 16%;">Label</th>
                                <th class="o_odomate_num" style="width: 8%;">Debit</th>
                                <th class="o_odomate_num" style="width: 8%;">Credit</th>
                                <th class="o_odomate_num" style="width: 9%;">Balance</th>
                                <th t-if="show_currency" class="o_odomate_num">Currency</th>
                                <th t-if="show_analytic">Analytic</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="blocks" t-as="block">
                                <tr class="table-active">
                                    <td t-att-colspan="ncols">
                                        <strong t-out="block['account_label']"/>
                                    </td>
                                </tr>
                                <tr t-foreach="block['rows']" t-as="row">
                                    <td>
                                        <span t-if="row['date']" t-out="row['date']" t-options="{'widget': 'date'}"/>
                                    </td>
                                    <td t-out="row['journal']"/>
                                    <td t-out="row['partner']"/>
                                    <td t-out="row['ref']"/>
                                    <td t-out="row['move_name']"/>
                                    <td>
                                        <t t-if="row['opening']">Opening Balance</t>
                                        <span t-if="not row['opening']" t-out="row['label']"/>
                                    </td>
                                    <td class="o_odomate_num">
                                        <span t-if="not row['opening']" t-out="row['debit']" t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                    </td>
                                    <td class="o_odomate_num">
                                        <span t-if="not row['opening']" t-out="row['credit']" t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                    </td>
                                    <td class="o_odomate_num">
                                        <span t-out="row['balance']" t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                    </td>
                                    <td t-if="show_currency" class="o_odomate_num">
                                        <span t-if="row['currency']" t-out="row['amount_currency']" t-options="{'widget': 'monetary', 'display_currency': row['currency']}"/>
                                    </td>
                                    <td t-if="show_analytic" t-out="row['analytic']"/>
                                </tr>
                                <tr>
                                    <td colspan="6" class="fw-bold">Total <span class="fw-normal" t-out="block['account_label']"/></td>
                                    <td class="o_odomate_num">
                                        <strong t-out="block['debit']" t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                    </td>
                                    <td class="o_odomate_num">
                                        <strong t-out="block['credit']" t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                    </td>
                                    <td class="o_odomate_num">
                                        <strong t-out="block['balance']" t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                    </td>
                                    <td t-if="show_currency"/>
                                    <td t-if="show_analytic"/>
                                </tr>
                            </t>
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="6" class="fw-bold">Grand Total</td>
                                <td class="o_odomate_num">
                                    <strong t-out="totals['debit']" t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                </td>
                                <td class="o_odomate_num">
                                    <strong t-out="totals['credit']" t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                </td>
                                <td class="o_odomate_num">
                                    <strong t-out="totals['balance']" t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                </td>
                                <td t-if="show_currency"/>
                                <td t-if="show_analytic"/>
                            </tr>
                        </tfoot>
                    </table>
                    <p t-if="not blocks">No journal item matches the selected filters.</p>
                </div>
            </t>
        </t>
    </template>

</odoo>
