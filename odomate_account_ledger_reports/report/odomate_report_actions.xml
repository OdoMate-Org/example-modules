<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_odomate_general_ledger" model="ir.actions.report">
        <field name="name">General Ledger</field>
        <field name="model">odomate.account.general.ledger.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">odomate_account_ledger_reports.report_general_ledger</field>
        <field name="report_file">odomate_account_ledger_reports.report_general_ledger</field>
        <field name="paperformat_id" ref="paperformat_odomate_ledger_landscape"/>
    </record>

    <record id="action_report_odomate_partner_ledger" model="ir.actions.report">
        <field name="name">Partner Ledger</field>
        <field name="model">odomate.account.partner.ledger.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">odomate_account_ledger_reports.report_partner_ledger</field>
        <field name="report_file">odomate_account_ledger_reports.report_partner_ledger</field>
        <field name="paperformat_id" ref="paperformat_odomate_ledger_landscape"/>
    </record>

    <record id="action_report_odomate_aged_partner" model="ir.actions.report">
        <field name="name">Aged Partner Balance</field>
        <field name="model">odomate.account.aged.partner.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">odomate_account_ledger_reports.report_aged_partner_balance</field>
        <field name="report_file">odomate_account_ledger_reports.report_aged_partner_balance</field>
        <field name="paperformat_id" ref="paperformat_odomate_ledger_landscape"/>
    </record>

    <record id="action_report_odomate_tax_report" model="ir.actions.report">
        <field name="name">Tax Report</field>
        <field name="model">odomate.account.tax.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">odomate_account_ledger_reports.report_tax_report</field>
        <field name="report_file">odomate_account_ledger_reports.report_tax_report</field>
    </record>

    <record id="action_report_odomate_journal_audit" model="ir.actions.report">
        <field name="name">Journals Audit</field>
        <field name="model">odomate.account.journal.audit.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">odomate_account_ledger_reports.report_journal_audit</field>
        <field name="report_file">odomate_account_ledger_reports.report_journal_audit</field>
        <field name="paperformat_id" ref="paperformat_odomate_ledger_landscape"/>
    </record>

    <record id="action_report_odomate_journal_entry" model="ir.actions.report">
        <field name="name">Journal Entry</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">odomate_account_ledger_reports.report_journal_entry</field>
        <field name="report_file">odomate_account_ledger_reports.report_journal_entry</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
        <field name="group_ids" eval="[(6, 0, [
            ref('account.group_account_manager'),
            ref('account.group_account_user'),
            ref('account.group_account_readonly'),
        ])]"/>
    </record>

</odoo>
