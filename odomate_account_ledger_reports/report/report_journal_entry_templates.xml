<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_journal_entry">
        <t t-call="web.html_container">
            <t t-foreach="entries" t-as="entry">
                <t t-set="o" t-value="entry['move']"/>
                <t t-set="company" t-value="entry['company']"/>
                <t t-set="currency" t-value="entry['currency']"/>
                <t t-call="web.external_layout">
                    <t t-call="odomate_account_ledger_reports.report_odomate_styles"/>
                    <div class="page">
                        <h2>Journal Entry <span t-out="entry['move'].name"/></h2>
                        <div class="row mb-3">
                            <div class="col-6">
                                <div class="fw-bold">Journal:<span class="fw-normal ms-1" t-out="entry['move'].journal_id.display_name"/></div>
                                <div class="fw-bold">Date:<span class="fw-normal ms-1" t-out="entry['move'].date" t-options="{'widget': 'date'}"/></div>
                                <div class="fw-bold">Status:<span class="fw-normal ms-1" t-out="entry['state_label']"/></div>
                            </div>
                            <div class="col-6">
                                <div class="fw-bold">Partner:<span class="fw-normal ms-1" t-out="entry['move'].partner_id.display_name"/></div>
                                <div class="fw-bold">Reference:<span class="fw-normal ms-1" t-out="entry['move'].ref"/></div>
                                <div class="fw-bold">Company:<span class="fw-normal ms-1" t-out="entry['company'].display_name"/></div>
                            </div>
                        </div>
                        <table class="table table-sm o_odomate_table">
                            <thead>
                                <tr>
                                    <th style="width: 26%;">Account</th>
                                    <th style="width: 22%;">Label</th>
                                    <th style="width: 18%;">Partner</th>
                                    <th t-if="show_analytic">Analytic</th>
                                    <th class="o_odomate_num" style="width: 12%;">Debit</th>
                                    <th class="o_odomate_num" style="width: 12%;">Credit</th>
                                    <th t-if="show_currency" class="o_odomate_num">Currency</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="entry['rows']" t-as="row">
                                    <td t-out="row['account_label']"/>
                                    <td t-out="row['label']"/>
                                    <td t-out="row['partner']"/>
                                    <td t-if="show_analytic" t-out="row['analytic']"/>
                                    <td class="o_odomate_num">
                                        <span t-out="row['debit']" t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                    </td>
                                    <td class="o_odomate_num">
                                        <span t-out="row['credit']" t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                    </td>
                                    <td t-if="show_currency" class="o_odomate_num">
                                        <span t-if="row['line_currency']" t-out="row['amount_currency']" t-options="{'widget': 'monetary', 'display_currency': row['line_currency']}"/>
                                    </td>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="3" class="fw-bold">Total</td>
                                    <td t-if="show_analytic"/>
                                    <td class="o_odomate_num">
                                        <strong t-out="entry['debit']" t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                    </td>
                                    <td class="o_odomate_num">
                                        <strong t-out="entry['credit']" t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                    </td>
                                    <td t-if="show_currency"/>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
