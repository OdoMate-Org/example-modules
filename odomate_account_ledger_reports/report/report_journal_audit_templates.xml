<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_journal_audit">
        <t t-call="web.html_container">
            <t t-call="web.internal_layout">
                <t t-call="odomate_account_ledger_reports.report_odomate_styles"/>
                <div class="page">
                    <h2 class="text-center">Journals Audit</h2>
                    <t t-call="odomate_account_ledger_reports.report_filter_header">
                        <t t-set="company" t-value="header['company']"/>
                        <t t-set="date_from" t-value="header['date_from']"/>
                        <t t-set="date_to" t-value="header['date_to']"/>
                        <t t-set="journals" t-value="header['journals']"/>
                        <t t-set="target_move_label" t-value="header['target_move_label']"/>
                    </t>
                    <t t-set="ncols" t-value="7 + (1 if show_currency else 0)"/>
                    <div t-foreach="blocks" t-as="block" class="mb-4 o_odomate_block">
                        <h3 t-out="block['journal_label']"/>
                        <table class="table table-sm o_odomate_table">
                            <thead>
                                <tr>
                                    <th style="width: 13%;">Entry</th>
                                    <th style="width: 9%;">Date</th>
                                    <th style="width: 20%;">Account</th>
                                    <th style="width: 16%;">Partner</th>
                                    <th style="width: 20%;">Label</th>
                                    <th class="o_odomate_num" style="width: 10%;">Debit</th>
                                    <th class="o_odomate_num" style="width: 10%;">Credit</th>
                                    <th t-if="show_currency" class="o_odomate_num">Currency</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="block['rows']" t-as="row">
                                    <td t-out="row['move_name']"/>
                                    <td>
                                        <span t-out="row['date']" t-options="{'widget': 'date'}"/>
                                    </td>
                                    <td t-out="row['account_label']"/>
                                    <td t-out="row['partner']"/>
                                    <td t-out="row['label']"/>
                                    <td class="o_odomate_num">
                                        <span t-out="row['debit']" t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                    </td>
                                    <td class="o_odomate_num">
                                        <span t-out="row['credit']" t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                    </td>
                                    <td t-if="show_currency" class="o_odomate_num">
                                        <span t-if="row['currency']" t-out="row['amount_currency']" t-options="{'widget': 'monetary', 'display_currency': row['currency']}"/>
                                    </td>
                                </tr>
                                <tr t-if="not block['rows']">
                                    <td t-att-colspan="ncols">No journal item matches the selected filters.</td>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="5" class="fw-bold">Total</td>
                                    <td class="o_odomate_num">
                                        <strong t-out="block['debit']" t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                    </td>
                                    <td class="o_odomate_num">
                                        <strong t-out="block['credit']" t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                    </td>
                                    <td t-if="show_currency"/>
                                </tr>
                            </tfoot>
                        </table>
                        <table t-if="block['tax_rows']" class="table table-sm o_odomate_table w-50">
                            <thead>
                                <tr>
                                    <th style="width: 50%;">Tax</th>
                                    <th class="o_odomate_num" style="width: 25%;">Base Amount</th>
                                    <th class="o_odomate_num" style="width: 25%;">Tax Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="block['tax_rows']" t-as="tax_row">
                                    <td t-out="tax_row['name']"/>
                                    <td class="o_odomate_num">
                                        <span t-out="tax_row['net']" t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                    </td>
                                    <td class="o_odomate_num">
                                        <span t-out="tax_row['tax']" t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </t>
        </t>
    </template>

</odoo>
