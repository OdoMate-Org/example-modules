<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_odomate_aged_partner_wizard_form" model="ir.ui.view">
        <field name="name">odomate.account.aged.partner.wizard.form</field>
        <field name="model">odomate.account.aged.partner.wizard</field>
        <field name="inherit_id" ref="view_odomate_account_report_filter_form"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <field name="date_from" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <field name="date_to" position="attributes">
                <attribute name="required">1</attribute>
            </field>
            <field name="journal_ids" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <field name="journal_ids" position="after">
                <field name="partner_ids"
                       widget="many2many_tags"
                       options="{'no_create': True, 'no_create_edit': True}"
                       placeholder="All partners"/>
            </field>
            <field name="target_move" position="after">
                <field name="result_selection"
                       widget="radio"
                       invisible="context.get('odomate_hide_result_selection')"/>
                <field name="period_length"/>
            </field>
        </field>
    </record>

    <record id="action_odomate_aged_partner_wizard" model="ir.actions.act_window">
        <field name="name">Aged Partner Balance</field>
        <field name="res_model">odomate.account.aged.partner.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_odomate_aged_partner_wizard_form"/>
        <field name="target">new</field>
    </record>

    <record id="action_odomate_aged_receivable" model="ir.actions.act_window">
        <field name="name">Aged Receivable</field>
        <field name="res_model">odomate.account.aged.partner.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_odomate_aged_partner_wizard_form"/>
        <field name="target">new</field>
        <field name="context">{'default_result_selection': 'customer', 'odomate_hide_result_selection': True}</field>
    </record>

    <record id="action_odomate_aged_payable" model="ir.actions.act_window">
        <field name="name">Aged Payable</field>
        <field name="res_model">odomate.account.aged.partner.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_odomate_aged_partner_wizard_form"/>
        <field name="target">new</field>
        <field name="context">{'default_result_selection': 'supplier', 'odomate_hide_result_selection': True}</field>
    </record>

</odoo>
