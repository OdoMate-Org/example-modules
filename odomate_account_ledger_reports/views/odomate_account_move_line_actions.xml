<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_odomate_account_ledger_by_account" model="ir.actions.act_window">
        <field name="name">Journal Items by Account</field>
        <field name="res_model">account.move.line</field>
        <field name="view_mode">list,pivot,graph</field>
        <field name="view_id" ref="account.view_move_line_tree_grouped_general"/>
        <field name="search_view_id" ref="account.view_account_move_line_filter"/>
        <field name="domain">[('display_type', 'not in', ('line_section', 'line_subsection', 'line_note'))]</field>
        <field name="context">{'search_default_group_by_account': 1, 'search_default_posted': 1}</field>
    </record>

    <record id="action_odomate_account_ledger_by_partner" model="ir.actions.act_window">
        <field name="name">Journal Items by Partner</field>
        <field name="res_model">account.move.line</field>
        <field name="view_mode">list,pivot,graph</field>
        <field name="view_id" ref="account.view_move_line_tree_grouped_partner"/>
        <field name="search_view_id" ref="account.view_account_move_line_filter"/>
        <field name="domain">[('display_type', 'not in', ('line_section', 'line_subsection', 'line_note'))]</field>
        <field name="context">{'search_default_group_by_partner': 1, 'search_default_posted': 1, 'search_default_trade_receivable': 1, 'search_default_trade_payable': 1, 'search_default_unreconciled': 1}</field>
    </record>

</odoo>
