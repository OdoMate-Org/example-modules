<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_odomate_journal_audit_wizard_form" model="ir.ui.view">
        <field name="name">odomate.account.journal.audit.wizard.form</field>
        <field name="model">odomate.account.journal.audit.wizard</field>
        <field name="inherit_id" ref="view_odomate_account_report_filter_form"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <field name="journal_ids" position="attributes">
                <attribute name="required">1</attribute>
                <attribute name="placeholder"/>
            </field>
            <field name="target_move" position="after">
                <field name="sort_selection" widget="radio"/>
                <field name="amount_currency" groups="base.group_multi_currency"/>
            </field>
        </field>
    </record>

    <record id="action_odomate_journal_audit_wizard" model="ir.actions.act_window">
        <field name="name">Journals Audit</field>
        <field name="res_model">odomate.account.journal.audit.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_odomate_journal_audit_wizard_form"/>
        <field name="target">new</field>
    </record>

</odoo>
