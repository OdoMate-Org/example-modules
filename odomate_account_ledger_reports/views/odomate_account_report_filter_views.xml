<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_odomate_account_report_filter_form" model="ir.ui.view">
        <field name="name">odomate.account.report.filter.form</field>
        <field name="model">odomate.account.report.filter</field>
        <field name="arch" type="xml">
            <form string="Accounting Report">
                <group>
                    <group name="odomate_period">
                        <field name="target_move" widget="radio"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group name="odomate_scope">
                        <field name="journal_ids"
                               widget="many2many_tags"
                               options="{'no_create': True, 'no_create_edit': True}"
                               placeholder="All journals"/>
                        <field name="company_id"
                               groups="base.group_multi_company"
                               options="{'no_create': True, 'no_open': True}"/>
                    </group>
                </group>
                <footer>
                    <button name="action_odomate_print"
                            string="Print"
                            type="object"
                            class="btn-primary"
                            data-hotkey="q"/>
                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"
                            data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
