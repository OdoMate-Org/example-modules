<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_odomate_general_ledger_wizard_form" model="ir.ui.view">
        <field name="name">odomate.account.general.ledger.wizard.form</field>
        <field name="model">odomate.account.general.ledger.wizard</field>
        <field name="inherit_id" ref="view_odomate_account_report_filter_form"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <field name="journal_ids" position="after">
                <field name="account_ids"
                       widget="many2many_tags"
                       options="{'no_create': True, 'no_create_edit': True}"
                       placeholder="All accounts"/>
                <field name="partner_ids"
                       widget="many2many_tags"
                       options="{'no_create': True, 'no_create_edit': True}"
                       placeholder="All partners"/>
                <field name="analytic_account_ids"
                       widget="many2many_tags"
                       options="{'no_create': True, 'no_create_edit': True}"
                       groups="analytic.group_analytic_accounting"
                       placeholder="All analytic accounts"/>
            </field>
            <field name="target_move" position="after">
                <field name="sortby" widget="radio"/>
                <field name="display_account" widget="radio"/>
                <field name="initial_balance"/>
            </field>
        </field>
    </record>

    <record id="action_odomate_general_ledger_wizard" model="ir.actions.act_window">
        <field name="name">General Ledger</field>
        <field name="res_model">odomate.account.general.ledger.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_odomate_general_ledger_wizard_form"/>
        <field name="target">new</field>
    </record>

</odoo>
