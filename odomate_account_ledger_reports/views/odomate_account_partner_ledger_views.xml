<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_odomate_partner_ledger_wizard_form" model="ir.ui.view">
        <field name="name">odomate.account.partner.ledger.wizard.form</field>
        <field name="model">odomate.account.partner.ledger.wizard</field>
        <field name="inherit_id" ref="view_odomate_account_report_filter_form"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <field name="journal_ids" position="after">
                <field name="partner_ids"
                       widget="many2many_tags"
                       options="{'no_create': True, 'no_create_edit': True}"
                       placeholder="All partners"/>
            </field>
            <field name="target_move" position="after">
                <field name="result_selection" widget="radio"/>
                <field name="reconciled"/>
                <field name="amount_currency" groups="base.group_multi_currency"/>
            </field>
        </field>
    </record>

    <record id="action_odomate_partner_ledger_wizard" model="ir.actions.act_window">
        <field name="name">Partner Ledger</field>
        <field name="res_model">odomate.account.partner.ledger.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_odomate_partner_ledger_wizard_form"/>
        <field name="target">new</field>
    </record>

    <record id="action_odomate_partner_ledger_print" model="ir.actions.act_window">
        <field name="name">Partner Ledger</field>
        <field name="res_model">odomate.account.partner.ledger.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_odomate_partner_ledger_wizard_form"/>
        <field name="target">new</field>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_type">report</field>
        <field name="group_ids" eval="[(6, 0, [
            ref('account.group_account_manager'),
            ref('account.group_account_user'),
            ref('account.group_account_readonly'),
        ])]"/>
        <field name="context">{'default_partner_ids': [(6, 0, active_ids)], 'default_result_selection': 'customer_supplier', 'default_reconciled': True}</field>
    </record>

</odoo>
