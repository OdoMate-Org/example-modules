<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_context_export_form" model="ir.ui.view">
        <field name="name">odomate.context.export.form</field>
        <field name="model">odomate.context.export</field>
        <field name="arch" type="xml">
            <form string="Export OdoMate Context">
                <field name="state" invisible="1"/>
                <div invisible="state != 'draft'">
                    <p>
                        Generate a redacted structural snapshot of this database
                        (<code>odomate_context.json</code>) for OdoMate:
                        installed modules, models &amp; fields, customized views,
                        settings and security groups.
                    </p>
                    <p>
                        <strong>Never included:</strong> business records, user or
                        partner data, credentials, or secret parameters. The file is
                        plain JSON — inspect it before uploading.
                    </p>
                </div>
                <group invisible="state != 'done'">
                    <field name="summary" nolabel="1" colspan="2"/>
                    <field name="filename" invisible="1"/>
                    <field name="snapshot_file" filename="filename" string="Download"/>
                </group>
                <div invisible="state != 'done'" class="mt-3">
                    <p>
                        <strong>Next step:</strong> upload this file to your
                        <a href="https://www.odomate.pro" target="_blank">OdoMate workspace</a>
                        under <em>Environment context</em>. Your next generated module
                        will be built against your actual Odoo — and tested on a replica
                        of it.
                    </p>
                </div>
                <footer>
                    <button name="action_generate" type="object" string="Generate snapshot"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_context_export" model="ir.actions.act_window">
        <field name="name">Export OdoMate Context</field>
        <field name="res_model">odomate.context.export</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_context_export"
              name="Export OdoMate Context"
              parent="base.menu_custom"
              action="action_context_export"
              groups="base.group_system"
              sequence="200"/>
</odoo>
