<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_inherit_odomate_hr_transfer" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.odomate.hr.transfer</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_odomate_transfers" type="object"
                        class="oe_stat_button" icon="fa-exchange"
                        groups="hr.group_hr_user">
                    <field name="odomate_transfer_count" widget="statinfo"
                           string="Transfers"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
