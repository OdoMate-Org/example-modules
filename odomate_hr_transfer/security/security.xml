<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="odomate_hr_transfer_company_rule" model="ir.rule">
        <field name="name">Employee Transfer: multi-company</field>
        <field name="model_id" ref="model_odomate_hr_transfer"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('employee_id.company_id', 'in', company_ids), ('new_company_id', 'in', company_ids)]</field>
    </record>
</odoo>
