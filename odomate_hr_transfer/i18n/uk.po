#: model_terms:ir.ui.view,arch_db:odomate_hr_transfer.view_odomate_hr_transfer_refuse_form
msgid ""
"Explain why this transfer is refused. The employee record is left untouched."
msgstr ""
"Поясніть, чому це переведення відхилено. Картка співробітника залишиться без "
"змін."

#. module: odomate_hr_transfer
#: code:addons/odomate_hr_transfer/models/odomate_hr_transfer.py:0
msgid ""
"Transfer %s must change at least one of department, job position, work "
"location, manager or company."
msgstr ""
"Переведення %s має змінювати принаймні одне з: відділ, посаду, робоче місце, "
"керівника або компанію."

#. module: odomate_hr_transfer
#: code:addons/odomate_hr_transfer/models/odomate_hr_transfer.py:0
msgid ""
"%(label)s is already %(value)s for %(employee)s. A transfer must record an "
"actual change."
msgstr ""
"%(label)s для %(employee)s вже має значення %(value)s. Переведення має "
"фіксувати реальну зміну."

#. module: odomate_hr_transfer
#: code:addons/odomate_hr_transfer/models/odomate_hr_transfer.py:0
msgid ""
"The effective date of transfer %(name)s must be later than %(date)s, the "
"date of the most recent version of %(employee)s."
msgstr ""
"Дата набрання чинності переведення %(name)s має бути пізнішою за %(date)s — "
"дату найновішої версії співробітника %(employee)s."

#. module: odomate_hr_transfer
#: code:addons/odomate_hr_transfer/models/odomate_hr_transfer.py:0
msgid ""
"Transfer %s has already been applied and can no longer be changed. Record a "
"new transfer to reverse or correct this move."
msgstr ""
"Переведення %s вже застосовано, і його більше не можна змінювати. "
"Зареєструйте нове переведення, щоб скасувати або виправити цей перехід."

#. module: odomate_hr_transfer
#: code:addons/odomate_hr_transfer/models/odomate_hr_transfer.py:0
msgid "Approve employee transfer %s"
msgstr "Затвердити переведення співробітника %s"

#. module: odomate_hr_transfer
#: code:addons/odomate_hr_transfer/models/odomate_hr_transfer.py:0
msgid "Only an HR Manager can approve employee transfer %s."
msgstr "Лише менеджер з персоналу може затвердити переведення співробітника %s."

#. module: odomate_hr_transfer
#: code:addons/odomate_hr_transfer/models/odomate_hr_transfer.py:0
msgid ""
"You cannot approve transfer %(name)s: it moves the employee to %(company)s, "
"which is not one of your allowed companies."
msgstr ""
"Ви не можете затвердити переведення %(name)s: воно переводить співробітника "
"до компанії %(company)s, яка не входить до переліку дозволених вам компаній."

#. module: odomate_hr_transfer
#: code:addons/odomate_hr_transfer/models/odomate_hr_transfer.py:0
msgid "Only a draft transfer can be sent for approval; %s is not draft."
msgstr "На затвердження можна надіслати лише переведення у стані чернетки; %s не є чернеткою."

#. module: odomate_hr_transfer
#: code:addons/odomate_hr_transfer/models/odomate_hr_transfer.py:0
msgid ""
"Only a transfer waiting for approval can be approved; %s is not waiting for "
"approval."
msgstr ""
"Затвердити можна лише переведення, яке очікує на затвердження; %s не очікує "
"на затвердження."

#. module: odomate_hr_transfer
#: code:addons/odomate_hr_transfer/models/odomate_hr_transfer.py:0
msgid "Transfer approved."
msgstr "Переведення затверджено."

#. module: odomate_hr_transfer
#: code:addons/odomate_hr_transfer/models/odomate_hr_transfer.py:0
msgid "Transfer %s can no longer be cancelled."
msgstr "Переведення %s більше не можна скасувати."

#. module: odomate_hr_transfer
#: code:addons/odomate_hr_transfer/models/odomate_hr_transfer.py:0
msgid "Transfer cancelled."
msgstr "Переведення скасовано."

#. module: odomate_hr_transfer
#: code:addons/odomate_hr_transfer/models/odomate_hr_transfer.py:0
msgid "Transfer %s can no longer be refused."
msgstr "Переведення %s більше не можна відхилити."

#. module: odomate_hr_transfer
#: code:addons/odomate_hr_transfer/models/odomate_hr_transfer.py:0
msgid "Transfer refused: %s"
msgstr "Переведення відхилено: %s"

#. module: odomate_hr_transfer
#: code:addons/odomate_hr_transfer/models/odomate_hr_transfer.py:0
msgid "Transfer %s must be approved before it can be applied."
msgstr "Переведення %s має бути затверджене, перш ніж його можна застосувати."

#. module: odomate_hr_transfer
#: code:addons/odomate_hr_transfer/models/odomate_hr_transfer.py:0
msgid ""
"Transfer %(name)s takes effect on %(date)s and cannot be applied before that "
"date."
msgstr ""
"Переведення %(name)s набирає чинності %(date)s і не може бути застосоване "
"раніше цієї дати."

#. module: odomate_hr_transfer
#: code:addons/odomate_hr_transfer/models/odomate_hr_transfer.py:0
msgid ""
"Transfer applied: a new version dated %s was added to the employee's history."
msgstr ""
"Переведення застосовано: до історії співробітника додано нову версію від %s."
