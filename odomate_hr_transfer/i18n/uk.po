#. module: odomate_hr_transfer
#: model:ir.actions.act_window,help:odomate_hr_transfer.action_odomate_hr_transfer
msgid ""
"<p class=\"o_view_nocontent_smiling_face\">\n"
"                Record a new employee transfer\n"
"            </p>\n"
"            <p>\n"
"                A transfer records a dated move — department, job position, work\n"
"                location, manager or company. Once approved and applied it adds a\n"
"                new dated version to the employee's history; it never overwrites\n"
"                or duplicates the employee record.\n"
"            </p>"
msgstr ""
"<p class=\"o_view_nocontent_smiling_face\">\n"
"                Зареєструйте нове переведення співробітника\n"
"            </p>\n"
"            <p>\n"
"                Переведення фіксує датований перехід — відділ, посаду, робоче\n"
"                місце, керівника або компанію. Після затвердження та застосування\n"
"                воно додає нову датовану версію до історії співробітника; воно\n"
"                ніколи не перезаписує та не дублює картку співробітника.\n"
"            </p>"

