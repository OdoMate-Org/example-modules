<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="group_equipment_viewer" model="res.groups">
        <field name="name">Equipment Viewer</field>
        <field name="comment">Read-only access to equipment currently assigned to the user.</field>
    </record>

    <record id="group_equipment_admin" model="res.groups">
        <field name="name">Equipment Administrator</field>
        <field name="comment">Full management of office equipment: check-out, return, repair, retire.</field>
        <field name="implied_ids" eval="[(4, ref('group_equipment_viewer'))]"/>
    </record>

    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_equipment_viewer'))]"/>
    </record>

    <record id="equipment_rule_viewer_own" model="ir.rule">
        <field name="name">Equipment: Viewer sees only own equipment</field>
        <field name="model_id" ref="model_office_equipment"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_equipment_viewer'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="equipment_rule_admin_all" model="ir.rule">
        <field name="name">Equipment: Administrator sees all equipment</field>
        <field name="model_id" ref="model_office_equipment"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_equipment_admin'))]"/>
    </record>

    <record id="equipment_rule_company" model="ir.rule">
        <field name="name">Equipment: Multi-company isolation</field>
        <field name="model_id" ref="model_office_equipment"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
