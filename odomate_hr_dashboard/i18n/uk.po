#. module: odomate_hr_dashboard
#. odoo-python
#: code:addons/odomate_hr_dashboard/models/odomate_hr_dashboard.py:0
msgid ""
"Turnover = departures in the selected period divided by average headcount "
"over the period, where average headcount = (headcount on the first day of "
"the period + headcount on the last day of the period) / 2."
msgstr ""
"Плинність = звільнення за обраний період, поділені на середню чисельність за "
"період, де середня чисельність = (чисельність у перший день періоду + "
"чисельність в останній день періоду) / 2."

#. module: odomate_hr_dashboard
#. odoo-python
#: code:addons/odomate_hr_dashboard/models/odomate_hr_dashboard.py:0
msgid ""
"%(left)s departures / average headcount %(average)s (%(headcount_from)s on "
"%(date_from)s, %(headcount_to)s on %(date_to)s) = %(rate)s%%"
msgstr ""
"%(left)s звільнень / середня чисельність %(average)s (%(headcount_from)s на "
"%(date_from)s, %(headcount_to)s на %(date_to)s) = %(rate)s%%"

#. module: odomate_hr_dashboard
#. odoo-python
#: code:addons/odomate_hr_dashboard/models/odomate_hr_dashboard.py:0
msgid ""
"%(left)s departures / average headcount 0 (%(headcount_from)s on "
"%(date_from)s, %(headcount_to)s on %(date_to)s) - turnover cannot be "
"computed without headcount"
msgstr ""
"%(left)s звільнень / середня чисельність 0 (%(headcount_from)s на "
"%(date_from)s, %(headcount_to)s на %(date_to)s) - плинність неможливо "
"обчислити без чисельності"
