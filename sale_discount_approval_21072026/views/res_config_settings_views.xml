<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_discount_approval" model="ir.ui.view">
        <field name="name">res.config.settings.form.discount.approval</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//setting[.//field[@name='group_discount_per_so_line']]" position="after">
                <setting id="so_order_approval_setting"
                         string="Sale Discount Approval"
                         help="Require a Sales Manager to approve orders whose average line discount exceeds a threshold.">
                    <field name="so_order_approval"/>
                    <div class="content-group mt16" invisible="not so_order_approval">
                        <div class="row">
                            <label for="so_double_validation_limit" class="col-lg-6 o_light_label"
                                   string="Discount Approval Limit (%)"/>
                            <field name="so_double_validation_limit"/>
                        </div>
                    </div>
                </setting>
            </xpath>

        </field>
    </record>

</odoo>
