<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form_discount" model="ir.ui.view">
        <field name="name">account.move.form.discount</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='invoice_line_ids']//field[@name='discount']" position="attributes">
                <attribute name="digits">[16, 2]</attribute>
            </xpath>

            <xpath expr="//field[@name='tax_totals']" position="after">
                <field name="amount_discount" readonly="1"/>
            </xpath>

            <xpath expr="//field[@name='narration']" position="before">
                <group string="Discount">
                    <field name="discount_type"/>
                    <field name="discount_rate"/>
                </group>
            </xpath>

        </field>
    </record>

</odoo>
