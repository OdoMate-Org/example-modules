<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_saleorder_document_discount"
              inherit_id="sale.report_saleorder_document">
        <xpath expr="//div[@id='total']" position="inside">
            <div class="row" t-if="doc.amount_discount">
                <div class="col-6"/>
                <div class="col-6">
                    <table class="table table-sm">
                        <tr>
                            <td><strong>Discount</strong></td>
                            <td class="text-end">
                                <span t-field="doc.amount_discount"
                                      t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                            </td>
                        </tr>
                    </table>
                </div>
            </div>
        </xpath>
    </template>

    <template id="sale_order_portal_content_totals_discount"
              inherit_id="sale.sale_order_portal_content_totals_table">
        <xpath expr="//table" position="inside">
            <tr t-if="sale_order.amount_discount" class="border-black">
                <td><strong>Discount</strong></td>
                <td class="text-end">
                    <span t-field="sale_order.amount_discount"
                          t-options='{"widget": "monetary", "display_currency": sale_order.currency_id}'/>
                </td>
            </tr>
        </xpath>
    </template>

</odoo>
