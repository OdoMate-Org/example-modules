<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_odomate_hr_custody_item_form" model="ir.ui.view">
        <field name="name">odomate.hr.custody.item.form</field>
        <field name="model">odomate.hr.custody.item</field>
        <field name="arch" type="xml">
            <form string="Custody Item">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_custody_requests" type="object"
                                class="oe_stat_button" icon="fa-exchange">
                            <span class="o_stat_text">Custody History</span>
                        </button>
                    </div>
                    <field name="image_1920" widget="image" class="oe_avatar"
                           options="{'preview_image': 'image_1920'}"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Dell Latitude 5540"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="product_id" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="is_available"/>
                            <field name="current_holder_id" invisible="is_available"/>
                            <field name="current_custody_id" invisible="is_available"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1" placeholder="Serial number, accessories, condition at purchase..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_odomate_hr_custody_item_list" model="ir.ui.view">
        <field name="name">odomate.hr.custody.item.list</field>
        <field name="model">odomate.hr.custody.item</field>
        <field name="arch" type="xml">
            <list string="Custody Items">
                <field name="name"/>
                <field name="product_id" optional="hide"/>
                <field name="current_holder_id"/>
                <field name="is_available" widget="boolean_toggle" readonly="1"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_odomate_hr_custody_item_kanban" model="ir.ui.view">
        <field name="name">odomate.hr.custody.item.kanban</field>
        <field name="model">odomate.hr.custody.item</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="is_available"/>
                <field name="image_1920"/>
                <field name="product_id"/>
                <field name="current_holder_id"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex">
                            <div class="me-3">
                                <img t-if="record.image_1920.raw_value"
                                     t-att-src="kanban_image('odomate.hr.custody.item', 'image_1920', record.id.raw_value)"
                                     alt="Item" class="o_image_64_contain"/>
                                <div t-else=""
                                     class="d-flex align-items-center justify-content-center bg-100 text-muted"
                                     style="width: 64px; height: 64px;">
                                    <i class="fa fa-cube fa-2x" title="No photo"/>
                                </div>
                            </div>
                            <div class="flex-grow-1">
                                <div class="fw-bold fs-5">
                                    <field name="name"/>
                                </div>
                                <div class="mt-1">
                                    <span t-if="record.is_available.raw_value" class="badge text-bg-success">
                                        Available
                                    </span>
                                    <span t-else="" class="badge text-bg-warning">
                                        Held by <field name="current_holder_id"/>
                                    </span>
                                </div>
                                <div class="mt-1" t-if="record.product_id.raw_value">
                                    <span class="badge text-bg-light">
                                        <i class="fa fa-tag me-1" title="Product"/>Product
                                    </span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_odomate_hr_custody_item_search" model="ir.ui.view">
        <field name="name">odomate.hr.custody.item.search</field>
        <field name="model">odomate.hr.custody.item</field>
        <field name="arch" type="xml">
            <search string="Custody Items">
                <field name="name"/>
                <field name="product_id"/>
                <filter name="filter_available" string="Available"
                        domain="[('custody_ids', 'not any', [('state', '=', 'approved')])]"/>
                <filter name="filter_in_custody" string="In Custody"
                        domain="[('custody_ids', 'any', [('state', '=', 'approved')])]"/>
                <group name="group_by">
                    <filter name="group_by_company" string="Company"
                            context="{'group_by': 'company_id'}"
                            groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_odomate_hr_custody_item" model="ir.actions.act_window">
        <field name="name">Custody Items</field>
        <field name="res_model">odomate.hr.custody.item</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_odomate_hr_custody_item_search"/>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">Register your first custody item</p><p>Custody items are the pieces of company property you hand over to employees: laptops, phones, tools, access cards, vehicles.</p></field>
    </record>
</odoo>
