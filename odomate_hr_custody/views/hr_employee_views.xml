<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_inherit_custody" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.odomate.custody</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_custody_requests" type="object"
                        class="oe_stat_button" icon="fa-exchange"
                        groups="hr.group_hr_user">
                    <field name="custody_count" widget="statinfo" string="Custody"/>
                </button>
                <button name="action_open_current_custody" type="object"
                        class="oe_stat_button" icon="fa-hand-paper-o"
                        groups="hr.group_hr_user">
                    <field name="custody_current_count" widget="statinfo" string="Held Now"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
