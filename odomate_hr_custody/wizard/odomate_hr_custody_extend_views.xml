<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_odomate_hr_custody_extend_form" model="ir.ui.view">
        <field name="name">odomate.hr.custody.extend.form</field>
        <field name="model">odomate.hr.custody.extend</field>
        <field name="arch" type="xml">
            <form string="Extend Return Date">
                <group>
                    <field name="request_id" invisible="1"/>
                    <field name="request_date" invisible="1"/>
                    <field name="current_return_date"/>
                    <field name="new_return_date"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Request Extension" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_odomate_hr_custody_extend" model="ir.actions.act_window">
        <field name="name">Extend Return Date</field>
        <field name="res_model">odomate.hr.custody.extend</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" eval="False"/>
    </record>
</odoo>
