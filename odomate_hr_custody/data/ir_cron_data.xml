<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_custody_return_reminder" model="ir.cron">
            <field name="name">Custody: Daily Return Reminders</field>
            <field name="model_id" ref="model_odomate_hr_custody"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_return_reminders()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 05:00:00')"/>
        </record>
    </data>
</odoo>
