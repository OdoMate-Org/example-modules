#: model_terms:ir.ui.view,arch_db:odomate_hr_custody.report_custody_handover_document
msgid "Job Position"
msgstr "Посада"

#. module: odomate_hr_custody
#: model_terms:ir.ui.view,arch_db:odomate_hr_custody.report_custody_handover_document
msgid "Department"
msgstr "Підрозділ"

#. module: odomate_hr_custody
#: model_terms:ir.ui.view,arch_db:odomate_hr_custody.report_custody_handover_document
msgid "Identification Reference"
msgstr "Ідентифікаційний номер"

#. module: odomate_hr_custody
#: model_terms:ir.ui.view,arch_db:odomate_hr_custody.report_custody_handover_document
msgid "Emergency Contact"
msgstr "Контактна особа на випадок нагальної потреби"

#. module: odomate_hr_custody
#: model_terms:ir.ui.view,arch_db:odomate_hr_custody.report_custody_handover_document
msgid "Emergency Phone"
msgstr "Телефон на випадок нагальної потреби"

#. module: odomate_hr_custody
#: model_terms:ir.ui.view,arch_db:odomate_hr_custody.report_custody_handover_document
