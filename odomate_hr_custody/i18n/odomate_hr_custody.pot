" t-out=\"format_date(object.return_date) or ''\">01/01/2026</t></p><p>Please"
" hand the item back to your HR contact, or request an extension of the return"
" date from the custody request:</p><p><a t-attf-href=\"{{"
" object.get_base_url() }}/odoo/action-odomate_hr_custody.action_odomate_hr_custody/{{"
" object.id }}\" style=\"background-color:#714B67;padding:8px"
" 16px;text-decoration:none;color:#ffffff;border-radius:5px;\">Open the custody"
" request</a></p><p>Thank you,<br/><t t-out=\"object.company_id.name or"
" ''\">Company</t></p></div>"
msgstr ""

