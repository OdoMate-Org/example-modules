<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_auditlog" model="res.groups.privilege">
        <field name="name">Auditlog Rights</field>
        <field name="sequence">90</field>
    </record>

    <record id="group_auditlog_user" model="res.groups">
        <field name="name">Auditlog User</field>
        <field name="privilege_id" ref="res_groups_privilege_auditlog"/>
    </record>

    <record id="group_auditlog_manager" model="res.groups">
        <field name="name">Auditlog Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_auditlog"/>
        <field name="implied_ids" eval="[(4, ref('group_auditlog_user'))]"/>
    </record>

    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_auditlog_manager'))]"/>
    </record>

    <record id="base.user_admin" model="res.users">
        <field name="group_ids" eval="[(4, ref('group_auditlog_manager'))]"/>
    </record>
</odoo>
