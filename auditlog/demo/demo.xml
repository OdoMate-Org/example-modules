    <!-- ============================================================ -->
    <record id="demo_rule_res_partner" model="auditlog.rule">
        <field name="name">Partner audit trail</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="log_type">full</field>
        <field name="log_create" eval="True"/>
        <field name="log_write" eval="True"/>
        <field name="log_unlink" eval="True"/>
        <field name="log_export_data" eval="True"/>
        <field name="log_read" eval="False"/>
        <field name="capture_record" eval="True"/>
        <field name="log_failure_policy">block</field>
        <field name="fields_to_exclude_ids" eval="[(6, 0, [ref('base.field_res_partner__comment')])]"/>
        <field name="state">draft</field>
    </record>
    <function model="auditlog.rule" name="set_to_confirmed" eval="[[ref('demo_rule_res_partner')]]"/>

