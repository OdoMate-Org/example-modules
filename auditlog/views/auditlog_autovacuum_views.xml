<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_auditlog_autovacuum_form" model="ir.ui.view">
        <field name="name">auditlog.autovacuum.form</field>
        <field name="model">auditlog.autovacuum</field>
        <field name="arch" type="xml">
            <form string="Delete Old Logs">
                <p>Delete audit logs (with their lines), HTTP requests and user sessions created before the retention period, oldest first.</p>
                <group>
                    <field name="days"/>
                    <field name="chunk_size"/>
                </group>
                <footer>
                    <button name="action_run" string="Delete Old Logs" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_auditlog_autovacuum" model="ir.actions.act_window">
        <field name="name">Delete Old Logs</field>
        <field name="res_model">auditlog.autovacuum</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
