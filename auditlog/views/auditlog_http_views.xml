<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_auditlog_http_session_form" model="ir.ui.view">
        <field name="name">auditlog.http.session.form</field>
        <field name="model">auditlog.http.session</field>
        <field name="arch" type="xml">
            <form string="User session" create="false" edit="false">
                <sheet>
                    <group>
                        <field name="create_date" string="Date"/>
                        <field name="user_id"/>
                        <field name="name"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    <field name="http_request_ids" readonly="1">
                        <list>
                            <field name="create_date" string="Date"/>
                            <field name="name"/>
                            <field name="root_url"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_auditlog_http_session_list" model="ir.ui.view">
        <field name="name">auditlog.http.session.list</field>
        <field name="model">auditlog.http.session</field>
        <field name="arch" type="xml">
            <list string="User sessions" create="false" edit="false">
                <field name="create_date" string="Date"/>
                <field name="user_id"/>
                <field name="name" optional="hide"/>
                <field name="company_id" optional="hide" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_auditlog_http_session_search" model="ir.ui.view">
        <field name="name">auditlog.http.session.search</field>
        <field name="model">auditlog.http.session</field>
        <field name="arch" type="xml">
            <search string="User sessions">
                <field name="user_id"/>
                <field name="name"/>
                <group name="group_by">
                    <filter name="group_by_user" string="User" context="{'group_by': 'user_id'}"/>
                    <filter name="group_by_date" string="Date" context="{'group_by': 'create_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_auditlog_http_session" model="ir.actions.act_window">
        <field name="name">User sessions</field>
        <field name="res_model">auditlog.http.session</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_auditlog_http_session_search"/>
    </record>

    <record id="view_auditlog_http_request_form" model="ir.ui.view">
        <field name="name">auditlog.http.request.form</field>
        <field name="model">auditlog.http.request</field>
        <field name="arch" type="xml">
            <form string="HTTP Request" create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="create_date" string="Date"/>
                            <field name="user_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="name"/>
                            <field name="root_url"/>
                            <field name="http_session_id"/>
                        </group>
                    </group>
                    <field name="log_ids" readonly="1">
                        <list>
                            <field name="create_date" string="Date"/>
                            <field name="name"/>
                            <field name="model_id"/>
                            <field name="method"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_auditlog_http_request_list" model="ir.ui.view">
        <field name="name">auditlog.http.request.list</field>
        <field name="model">auditlog.http.request</field>
        <field name="arch" type="xml">
            <list string="HTTP Requests" create="false" edit="false">
                <field name="create_date" string="Date"/>
                <field name="name"/>
                <field name="user_id"/>
                <field name="root_url" optional="hide"/>
                <field name="http_session_id" optional="hide"/>
                <field name="company_id" optional="hide" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_auditlog_http_request_search" model="ir.ui.view">
        <field name="name">auditlog.http.request.search</field>
        <field name="model">auditlog.http.request</field>
        <field name="arch" type="xml">
            <search string="HTTP Requests">
                <field name="name"/>
                <field name="user_id"/>
                <field name="http_session_id"/>
                <group name="group_by">
                    <filter name="group_by_user" string="User" context="{'group_by': 'user_id'}"/>
                    <filter name="group_by_session" string="Session" context="{'group_by': 'http_session_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_auditlog_http_request" model="ir.actions.act_window">
        <field name="name">HTTP Requests</field>
        <field name="res_model">auditlog.http.request</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_auditlog_http_request_search"/>
    </record>
</odoo>
