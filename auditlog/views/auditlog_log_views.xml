<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_auditlog_log_form" model="ir.ui.view">
        <field name="name">auditlog.log.form</field>
        <field name="model">auditlog.log</field>
        <field name="arch" type="xml">
            <form string="Log" create="false" edit="false">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="show_res_ids" type="object" class="oe_stat_button" icon="fa-list" invisible="not res_ids">
                            <field name="exported_count" widget="statinfo" string="Exported Records"/>
                        </button>
                    </div>
                    <group>
                        <group string="Log">
                            <field name="create_date" string="Date"/>
                            <field name="user_id"/>
                            <field name="method"/>
                            <field name="log_type"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Resource">
                            <field name="name"/>
                            <field name="model_id"/>
                            <field name="model_model"/>
                            <field name="res_id"/>
                            <field name="res_ids" invisible="not res_ids"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Fields updated" name="lines">
                            <field name="line_ids" readonly="1">
                                <list>
                                    <field name="field_description"/>
                                    <field name="field_name" optional="hide"/>
                                    <field name="old_value" optional="hide"/>
                                    <field name="old_value_text"/>
                                    <field name="new_value" optional="hide"/>
                                    <field name="new_value_text"/>
                                </list>
                            </field>
                        </page>
                        <page string="Technical" name="technical">
                            <group>
                                <field name="http_session_id"/>
                                <field name="http_request_id"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_auditlog_log_list" model="ir.ui.view">
        <field name="name">auditlog.log.list</field>
        <field name="model">auditlog.log</field>
        <field name="arch" type="xml">
            <list string="Logs" create="false" edit="false">
                <field name="create_date" string="Date"/>
                <field name="name"/>
                <field name="model_id"/>
                <field name="res_id" optional="hide"/>
                <field name="method"/>
                <field name="user_id"/>
                <field name="log_type" optional="hide"/>
                <field name="company_id" optional="hide" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_auditlog_log_search" model="ir.ui.view">
        <field name="name">auditlog.log.search</field>
        <field name="model">auditlog.log</field>
        <field name="arch" type="xml">
            <search string="Logs">
                <field name="name"/>
                <field name="model_id"/>
                <field name="res_id"/>
                <field name="user_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <filter name="filter_create" string="Create" domain="[('method', '=', 'create')]"/>
                <filter name="filter_write" string="Write" domain="[('method', '=', 'write')]"/>
                <filter name="filter_unlink" string="Delete" domain="[('method', '=', 'unlink')]"/>
                <filter name="filter_read" string="Read" domain="[('method', '=', 'read')]"/>
                <filter name="filter_export" string="Export" domain="[('method', '=', 'export_data')]"/>
                <group name="group_by">
                    <filter name="group_by_user" string="User" context="{'group_by': 'user_id'}"/>
                    <filter name="group_by_model" string="Model" context="{'group_by': 'model_id'}"/>
                    <filter name="group_by_method" string="Method" context="{'group_by': 'method'}"/>
                    <filter name="group_by_company" string="Company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                    <filter name="group_by_date" string="Date" context="{'group_by': 'create_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_auditlog_log" model="ir.actions.act_window">
        <field name="name">Logs</field>
        <field name="res_model">auditlog.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_auditlog_log_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">No audit log yet</p>
            <p>Logs appear here once a confirmed rule records an operation.</p>
        </field>
    </record>

    <record id="view_auditlog_log_line_view_list" model="ir.ui.view">
        <field name="name">auditlog.log.line.view.list</field>
        <field name="model">auditlog.log.line.view</field>
        <field name="arch" type="xml">
            <list string="Log Lines" create="false" edit="false" delete="false">
                <field name="create_date" string="Date"/>
                <field name="user_id"/>
                <field name="name"/>
                <field name="model_id"/>
                <field name="model_model" optional="hide"/>
                <field name="res_id" optional="hide"/>
                <field name="method"/>
                <field name="field_description"/>
                <field name="field_name" optional="hide"/>
                <field name="old_value" optional="hide"/>
                <field name="old_value_text"/>
                <field name="new_value" optional="hide"/>
                <field name="new_value_text"/>
                <field name="http_session_id" optional="hide"/>
                <field name="http_request_id" optional="hide"/>
                <field name="log_type" optional="hide"/>
                <field name="company_id" optional="hide" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_auditlog_log_line_view_search" model="ir.ui.view">
        <field name="name">auditlog.log.line.view.search</field>
        <field name="model">auditlog.log.line.view</field>
        <field name="arch" type="xml">
            <search string="Log Lines">
                <field name="name"/>
                <field name="model_id"/>
                <field name="res_id"/>
                <field name="field_description"/>
                <field name="user_id"/>
                <field name="old_value_text"/>
                <field name="new_value_text"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <filter name="filter_create" string="Create" domain="[('method', '=', 'create')]"/>
                <filter name="filter_write" string="Write" domain="[('method', '=', 'write')]"/>
                <filter name="filter_unlink" string="Delete" domain="[('method', '=', 'unlink')]"/>
                <group name="group_by">
                    <filter name="group_by_user" string="User" context="{'group_by': 'user_id'}"/>
                    <filter name="group_by_model" string="Model" context="{'group_by': 'model_id'}"/>
                    <filter name="group_by_field" string="Field" context="{'group_by': 'field_id'}"/>
                    <filter name="group_by_company" string="Company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_auditlog_log_line_view" model="ir.actions.act_window">
        <field name="name">Log Lines</field>
        <field name="res_model">auditlog.log.line.view</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_auditlog_log_line_view_search"/>
    </record>
</odoo>
