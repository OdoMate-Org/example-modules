<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sample_request_reject_wizard_view_form" model="ir.ui.view">
        <field name="name">sample.request.reject.wizard.form</field>
        <field name="model">sample.request.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Sample Request">
                <field name="request_id" invisible="1"/>
                <group>
                    <field name="rejection_reason" placeholder="Explain why this sample request is rejected..."/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Reject" class="btn-primary" data-hotkey="q"/>
                    <button string="Discard" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="sample_request_reject_wizard_action" model="ir.actions.act_window">
        <field name="name">Reject Sample Request</field>
        <field name="res_model">sample.request.reject.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
