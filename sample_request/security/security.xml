<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_sample_request_user" model="res.groups">
        <field name="name">Sample Request / User</field>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
    </record>

    <record id="group_sample_request_manager" model="res.groups">
        <field name="name">Sample Request / Manager</field>
        <field name="implied_ids" eval="[(4, ref('group_sample_request_user'))]"/>
    </record>

    <!-- Whoever installs the module must be able to use it immediately:
         without this, menus gated on these groups are invisible to everyone. -->
    <record id="base.user_admin" model="res.users">
        <field name="group_ids" eval="[(4, ref('group_sample_request_manager'))]"/>
    </record>
</odoo>
