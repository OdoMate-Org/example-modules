<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_inherit_resignation" model="ir.ui.view">
        <field name="name">res.config.settings.form.inherit.odomate.resignation</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='hr']" position="inside">
                <block title="Resignation &amp; Clearance" name="odomate_resignation_block">
                    <setting id="odomate_resignation_manager_approval"
                             string="Manager Approval on Resignations"
                             help="Require the employee's manager to approve a resignation before HR starts the clearance checklist.">
                        <field name="resignation_manager_approval_required"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
