<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_employee_form_inherit_resignation" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.odomate.resignation</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="active_resignation_id" invisible="1"
                       groups="hr.group_hr_user"/>
                <button name="action_open_resignations" type="object"
                        class="oe_stat_button" icon="fa-sign-out"
                        groups="hr.group_hr_user"
                        invisible="resignation_count == 0">
                    <field name="resignation_count" widget="statinfo"
                           string="Resignations"/>
                </button>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="after">
                <div class="alert alert-warning" role="alert"
                     groups="hr.group_hr_user"
                     invisible="not active_resignation_id">
                    An ongoing resignation is recorded for this employee.
                    <button name="action_open_resignations" type="object"
                            class="btn-link p-0 align-baseline"
                            string="Open it"/>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
