#. module: odomate_hr_resignation
#. odoo-python
#: code:addons/odomate_hr_resignation/models/odomate_hr_resignation.py:0
msgid "Only a draft resignation can be confirmed."
msgstr "Підтвердити можна лише заяву в стані чернетки."

#. module: odomate_hr_resignation
#. odoo-python
#: code:addons/odomate_hr_resignation/models/odomate_hr_resignation.py:0
msgid "Only a confirmed resignation can be approved by the manager."
msgstr "Керівник може схвалити лише підтверджену заяву."

#. module: odomate_hr_resignation
#. odoo-python
#: code:addons/odomate_hr_resignation/models/odomate_hr_resignation.py:0
msgid "Only %(manager)s or an HR officer can approve this resignation."
msgstr "Схвалити цю заяву може лише %(manager)s або співробітник відділу кадрів."

#. module: odomate_hr_resignation
#. odoo-python
#: code:addons/odomate_hr_resignation/models/odomate_hr_resignation.py:0
msgid "Only an HR officer can approve a resignation and open the exit clearance."
msgstr "Лише співробітник відділу кадрів може схвалити заяву та відкрити обхідний лист."

#. module: odomate_hr_resignation
#. odoo-python
#: code:addons/odomate_hr_resignation/models/odomate_hr_resignation.py:0
msgid "Only a confirmed or manager-approved resignation can be approved by HR."
msgstr "Відділ кадрів може схвалити лише підтверджену або схвалену керівником заяву."

#. module: odomate_hr_resignation
#. odoo-python
#: code:addons/odomate_hr_resignation/models/odomate_hr_resignation.py:0
msgid "Only an HR officer can release an employee."
msgstr "Лише співробітник відділу кадрів може звільнити працівника."

#. module: odomate_hr_resignation
#. odoo-python
#: code:addons/odomate_hr_resignation/models/odomate_hr_resignation.py:0
msgid "Only a resignation that HR has not approved yet can be refused."
msgstr "Відхилити можна лише заяву, яку відділ кадрів ще не схвалив."

#. module: odomate_hr_resignation
#. odoo-python
#: code:addons/odomate_hr_resignation/models/odomate_hr_resignation.py:0
msgid "Only a resignation whose exit clearance has been opened can be released."
msgstr "Звільнити можна лише заяву, для якої відкрито обхідний лист."

#. module: odomate_hr_resignation
#. odoo-python
#: code:addons/odomate_hr_resignation/models/odomate_hr_resignation.py:0
msgid "%(employee)s is still registered as holding company property. The custody register reports the following as not returned:\n%(items)s"
msgstr "За %(employee)s досі рахується майно компанії. Реєстр відповідального зберігання показує як неповернуте:\n%(items)s"

#. module: odomate_hr_resignation
#. odoo-python
#: code:addons/odomate_hr_resignation/models/odomate_hr_resignation.py:0
msgid "The exit clearance checklist is not complete. The following entries are still open:\n%(items)s"
msgstr "Обхідний лист не завершено. Досі відкриті такі пункти:\n%(items)s"

#. module: odomate_hr_resignation
#. odoo-python
#: code:addons/odomate_hr_resignation/models/odomate_hr_resignation.py:0
msgid "- %(item)s (handover %(reference)s, due %(due_date)s)"
msgstr "- %(item)s (передача %(reference)s, термін %(due_date)s)"

#. module: odomate_hr_resignation
#. odoo-python
#: code:addons/odomate_hr_resignation/models/odomate_hr_resignation.py:0
msgid "- %(item)s (%(status)s, %(responsible)s)"
msgstr "- %(item)s (%(status)s, %(responsible)s)"

#. module: odomate_hr_resignation
#. odoo-python
#: code:addons/odomate_hr_resignation/models/odomate_hr_resignation.py:0
msgid "Company property still registered to this employee when HR approved the resignation:\n%(items)s"
msgstr "Майно компанії, що рахувалося за працівником на момент схвалення заяви відділом кадрів:\n%(items)s"

#. module: odomate_hr_resignation
#. odoo-python
#: code:addons/odomate_hr_resignation/models/odomate_hr_resignation.py:0
msgid "%(reference)s has already been released. Its dates, reason and clearance checklist cannot be changed any more."
msgstr "%(reference)s вже звільнено. Дати, причину та обхідний лист більше не можна змінювати."

#. module: odomate_hr_resignation
#. odoo-python
#: code:addons/odomate_hr_resignation/models/odomate_hr_resignation.py:0
msgid "%(reference)s has already been released and can no longer be withdrawn."
msgstr "%(reference)s вже звільнено, тому заяву неможливо відкликати."

#. module: odomate_hr_resignation
#. odoo-python
#: code:addons/odomate_hr_resignation/models/odomate_hr_resignation.py:0
msgid "This resignation is already closed."
msgstr "Цю заяву вже закрито."

#. module: odomate_hr_resignation
#. odoo-python
#: code:addons/odomate_hr_resignation/models/odomate_hr_resignation.py:0
msgid "%(employee)s already has a resignation that is neither refused nor withdrawn (%(reference)s). Close that one before recording a new one."
msgstr "У %(employee)s вже є заява, яку не відхилено й не відкликано (%(reference)s). Закрийте її, перш ніж створювати нову."

#. module: odomate_hr_resignation
#. odoo-python
#: code:addons/odomate_hr_resignation/models/odomate_hr_resignation.py:0
msgid "%(employee)s cannot have two resignations recorded at once."
msgstr "Для %(employee)s не можна створити дві заяви одночасно."

#. module: odomate_hr_resignation
#. odoo-python
#: code:addons/odomate_hr_resignation/models/odomate_hr_resignation.py:0
msgid "The last working day cannot be earlier than the notification date."
msgstr "Останній робочий день не може бути раніше дати повідомлення."

#. module: odomate_hr_resignation
#. odoo-python
#: code:addons/odomate_hr_resignation/models/odomate_hr_resignation.py:0
msgid "Approve the resignation of %s"
msgstr "Схваліть заяву про звільнення: %s"

#. module: odomate_hr_resignation
#. odoo-python
#: code:addons/odomate_hr_resignation/models/odomate_hr_resignation.py:0
msgid "HR review of the resignation of %s"
msgstr "Розгляд відділом кадрів заяви про звільнення: %s"

#. module: odomate_hr_resignation
#. odoo-python
#: code:addons/odomate_hr_resignation/models/odomate_hr_resignation.py:0
msgid "Start the exit clearance for %s"
msgstr "Розпочніть обхідний лист для %s"

#. module: odomate_hr_resignation
#. odoo-python
#: code:addons/odomate_hr_resignation/models/odomate_hr_resignation.py:0
msgid "Exit clearance: %(item)s for %(employee)s"
msgstr "Обхідний лист: %(item)s для %(employee)s"

#. module: odomate_hr_resignation
#. odoo-python
#: code:addons/odomate_hr_resignation/models/odomate_hr_resignation.py:0
msgid "Notified on %(notified)s, proposed last working day %(last_day)s."
msgstr "Повідомлено %(notified)s, запропонований останній робочий день %(last_day)s."

#. module: odomate_hr_resignation
#. odoo-python
#: code:addons/odomate_hr_resignation/models/odomate_hr_resignation.py:0
msgid "Approved by the manager."
msgstr "Схвалено керівником."

#. module: odomate_hr_resignation
#. odoo-python
#: code:addons/odomate_hr_resignation/models/odomate_hr_resignation.py:0
msgid "Approved by HR."
msgstr "Схвалено відділом кадрів."

#. module: odomate_hr_resignation
#. odoo-python
#: code:addons/odomate_hr_resignation/models/odomate_hr_resignation.py:0
msgid "Resignation refused."
msgstr "Заяву про звільнення відхилено."

#. module: odomate_hr_resignation
#. odoo-python
#: code:addons/odomate_hr_resignation/models/odomate_hr_resignation.py:0
msgid "Resignation refused: %s"
msgstr "Заяву про звільнення відхилено: %s"

#. module: odomate_hr_resignation
#. odoo-python
#: code:addons/odomate_hr_resignation/models/odomate_hr_resignation.py:0
msgid "Resignation withdrawn."
msgstr "Заяву про звільнення відкликано."

#. module: odomate_hr_resignation
#. odoo-python
#: code:addons/odomate_hr_resignation/models/odomate_hr_resignation.py:0
msgid "Resignation withdrawn. The employee record is left untouched."
msgstr "Заяву відкликано. Картку працівника не змінено."

#. module: odomate_hr_resignation
#. odoo-python
#: code:addons/odomate_hr_resignation/models/odomate_hr_resignation.py:0
msgid "Resignation released."
msgstr "Звільнення проведено."

#. module: odomate_hr_resignation
#. odoo-python
#: code:addons/odomate_hr_resignation/models/odomate_hr_resignation.py:0
msgid "Released on %(release_date)s. The employee record has been archived."
msgstr "Звільнено %(release_date)s. Картку працівника заархівовано."

#. module: odomate_hr_resignation
#. odoo-python
#: code:addons/odomate_hr_resignation/models/odomate_hr_resignation.py:0
msgid "The current employee version has no contract start date, so no contract end date was set on it."
msgstr "Поточна версія працівника не має дати початку контракту, тому дату завершення не встановлено."

#. module: odomate_hr_resignation
#. odoo-python
#: code:addons/odomate_hr_resignation/models/odomate_hr_resignation.py:0
msgid "No clearance item is configured, so the outstanding company property could not be snapshotted. The release check still reads the custody register live."
msgstr "Не налаштовано жодного пункту обхідного листа, тому знімок неповернутого майна не створено. Перевірка при звільненні все одно читає реєстр наживо."

#. module: odomate_hr_resignation
#. odoo-python
#: code:addons/odomate_hr_resignation/models/odomate_hr_resignation.py:0
msgid "The exit interview can only be sent once the resignation has been approved."
msgstr "Вихідне інтерв'ю можна надіслати лише після схвалення заяви."

#. module: odomate_hr_resignation
#. odoo-python
#: code:addons/odomate_hr_resignation/models/odomate_hr_resignation.py:0
msgid "Select an exit interview survey first."
msgstr "Спочатку оберіть опитування для вихідного інтерв'ю."

#. module: odomate_hr_resignation
#. odoo-python
#: code:addons/odomate_hr_resignation/models/odomate_hr_resignation.py:0
msgid "%(employee)s has no work contact or user, so no exit interview invitation can be addressed."
msgstr "У %(employee)s немає робочого контакту чи користувача, тому запрошення на вихідне інтерв'ю нікому надіслати."

#. module: odomate_hr_resignation
#. odoo-python
#: code:addons/odomate_hr_resignation/models/odomate_hr_resignation.py:0
msgid "The exit interview has not been answered yet."
msgstr "На вихідне інтерв'ю ще не відповіли."

#. module: odomate_hr_resignation
#. odoo-python
#: code:addons/odomate_hr_resignation/models/odomate_hr_resignation.py:0
msgid "Outstanding Company Property"
msgstr "Неповернуте майно компанії"

#. module: odomate_hr_resignation
#. odoo-python
#: code:addons/odomate_hr_resignation/models/odomate_hr_resignation_clearance_line.py:0
msgid "Only %(responsible)s or an HR officer can update this clearance line."
msgstr "Оновити цей пункт обхідного листа може лише %(responsible)s або співробітник відділу кадрів."

#. module: odomate_hr_resignation
#. odoo-python
#: code:addons/odomate_hr_resignation/models/odomate_hr_resignation_clearance_line.py:0
msgid "The exit clearance of a released resignation can no longer be changed."
msgstr "Обхідний лист після звільнення більше не можна змінювати."

#. module: odomate_hr_resignation
#. odoo-python
#: code:addons/odomate_hr_resignation/models/odomate_hr_resignation_clearance_line.py:0
msgid "Add a remark explaining what blocks %(item)s before marking it as blocked."
msgstr "Додайте примітку з поясненням, що блокує %(item)s, перш ніж позначати пункт як заблокований."

#. module: odomate_hr_resignation
#. odoo-python
#: code:addons/odomate_hr_resignation/wizard/odomate_hr_resignation_refuse.py:0
msgid "Please explain why this resignation is refused."
msgstr "Будь ласка, поясніть, чому цю заяву відхилено."

