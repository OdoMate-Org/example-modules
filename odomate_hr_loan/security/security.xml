<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_odomate_hr_loan_hr_officer" model="ir.rule">
        <field name="name">Employee loan: HR sees every loan</field>
        <field name="model_id" ref="model_odomate_hr_loan"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
    </record>

    <record id="rule_odomate_hr_loan_own" model="ir.rule">
        <field name="name">Employee loan: own loans only</field>
        <field name="model_id" ref="model_odomate_hr_loan"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_odomate_hr_loan_company" model="ir.rule">
        <field name="name">Employee loan: multi-company</field>
        <field name="model_id" ref="model_odomate_hr_loan"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_odomate_hr_loan_instalment_hr_officer" model="ir.rule">
        <field name="name">Loan instalment: HR sees every instalment</field>
        <field name="model_id" ref="model_odomate_hr_loan_instalment"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
    </record>

    <record id="rule_odomate_hr_loan_instalment_own" model="ir.rule">
        <field name="name">Loan instalment: own instalments only</field>
        <field name="model_id" ref="model_odomate_hr_loan_instalment"/>
        <field name="domain_force">[('loan_id.employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_odomate_hr_loan_instalment_company" model="ir.rule">
        <field name="name">Loan instalment: multi-company</field>
        <field name="model_id" ref="model_odomate_hr_loan_instalment"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
